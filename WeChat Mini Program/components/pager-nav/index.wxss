/* 统一翻页控件：居中"上一页 · 页号指示 · 下一页"。
   容器显式限宽并裁剪溢出，按钮与指示区禁止换行，窄屏不产生横向滚动。 */
.pager-nav { width: 100%; max-width: 100%; box-sizing: border-box; overflow: hidden; display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 18rpx; }
.pager-nav-button { flex: none; margin: 0; min-height: 72rpx; padding: 0 26rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; border: 1rpx solid #cbdadd; border-radius: 14rpx; color: #176f7f; background: #fff; font-size: 23rpx; line-height: 1; }
.pager-nav-button[disabled] { color: #9db3ba; border-color: #dbe5e8; background: #f2f7f8; }
.pager-nav-button:focus { outline: 4rpx solid #176373; outline-offset: 2rpx; }
.pager-nav-indicator { flex: 0 1 auto; min-width: 0; display: flex; align-items: baseline; gap: 6rpx; white-space: nowrap; overflow: hidden; }
.pager-nav-indicator text { white-space: nowrap; }
.pager-nav-current { color: #176f7f; font-size: 30rpx; font-weight: 800; }
.pager-nav-total { color: #46616c; font-size: 23rpx; }
.pager-nav-count { color: #819399; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; }
