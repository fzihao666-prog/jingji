/* 底部备案信息：页面固定内容区（非悬浮），居中低对比辅助色，适配底部安全区域。 */
.filing-footer {
  width: 100%;
  margin: 48rpx auto 0;
  padding: 8rpx 16rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--muted, #6d8088);
  text-align: center;
}

.filing-number {
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 24rpx;
  color: var(--muted, #6d8088);
  background: transparent;
  font-size: 25rpx;
  line-height: 1.5;
  text-decoration: underline;
}

.filing-number::after { border: 0; }
.filing-number:focus { box-shadow: inset 0 0 0 3rpx var(--river, #176f7f); }

.filing-hint, .filing-url {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
}
.filing-hint { margin-top: 4rpx; }
.filing-url { margin-top: 6rpx; word-break: break-all; }
