.team-stat-card {
  min-width: 0;
}

.team-stat-picker,
.team-stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  overflow-wrap: anywhere;
}

.team-stat-picker {
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: var(--radius-item);
  background: var(--mist);
}

.team-stat-picker text:nth-child(2) {
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-word;
}

.team-stat-periods {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.team-stat-card .team-stat-periods button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 12rpx 16rpx;
  line-height: 1.35;
}

.team-stat-card .team-stat-period-active {
  color: var(--paper);
  background: var(--river);
  border-color: var(--river);
}

.team-stat-section,
.team-stat-chart {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.team-stat-status {
  padding: 28rpx 0;
  color: var(--muted);
}

.team-stat-scroll {
  width: 100%;
}

.team-stat-volume-totals {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.team-stat-volume-totals > view {
  display: grid;
  min-width: 0;
  gap: 4rpx;
  padding: 12rpx;
  border-radius: var(--radius-item);
  background: var(--mist);
  color: var(--ink);
  font-size: 22rpx;
}

.team-stat-volume-value {
  overflow-wrap: anywhere;
  font-size: 30rpx;
  font-weight: 700;
}

.team-stat-volume-value text {
  font-size: 20rpx;
}

.team-stat-volume-selection {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 14rpx;
  min-height: 48rpx;
  padding-top: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.team-stat-frame {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding-top: 10rpx;
}

.team-stat-axis {
  display: flex;
  flex: 0 0 76rpx;
  flex-direction: column;
  justify-content: space-between;
  height: 146rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 18rpx;
  text-align: right;
}

.team-stat-plot {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
}

.team-stat-gridlines {
  position: absolute;
  inset: 0 0 auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 146rpx;
  pointer-events: none;
}

.team-stat-gridlines view {
  height: 1rpx;
  background: var(--line);
}

.team-stat-point {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 0;
  overflow: visible;
  background: transparent;
  line-height: 1.25;
}

.team-stat-track {
  height: 146rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.team-stat-point-selected .team-stat-track {
  background: rgba(23, 111, 127, 0.14);
}

.team-stat-bar {
  width: 65%;
  max-width: 32rpx;
  min-height: 1rpx;
  border-radius: 5rpx 5rpx 0 0;
  background: var(--river);
}

.team-stat-zero {
  min-height: 4rpx;
  background: var(--muted);
}

.team-stat-label-slot {
  position: relative;
  height: 32rpx;
}

.team-stat-label {
  position: absolute;
  left: 50%;
  padding-top: 6rpx;
  transform: translateX(-50%);
  color: var(--muted);
  font-size: 18rpx;
  white-space: nowrap;
}

.team-stat-label-first {
  left: 0;
  transform: none;
}

.team-stat-label-last {
  right: 0;
  left: auto;
  transform: none;
}

.team-stat-row {
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 24rpx;
}

.team-stat-row text:first-child {
  min-width: 0;
  word-break: break-word;
}

.team-stat-row text:last-child {
  text-align: right;
}

.team-stat-table-head {
  font-weight: 700;
}

.team-stat-distribution-track {
  height: 8rpx;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
  background: var(--mist);
  overflow: hidden;
}

.team-stat-distribution-track view {
  height: 100%;
  background: var(--teal);
}

.team-stat-donut {
  display: grid;
  place-items: center;
  width: 200rpx;
  height: 200rpx;
  margin: 16rpx auto;
  border-radius: 50%;
}

.team-stat-donut-center {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--paper);
}

.team-stat-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.team-stat-matrix {
  display: inline-block;
  width: max-content;
  min-width: 100%;
  margin-top: 12rpx;
}

.team-stat-matrix-row {
  display: flex;
  min-height: 58rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 24rpx;
}

.team-stat-matrix-label,
.team-stat-cell {
  padding: 12rpx;
  background: var(--paper);
}

.team-stat-matrix-label {
  position: sticky;
  left: 0;
  z-index: 1;
  flex: 0 0 192rpx;
  border-right: 1rpx solid var(--line);
  word-break: break-word;
}

.team-stat-cell {
  flex: 0 0 112rpx;
  text-align: right;
}

.team-stat-week-navigation {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.team-stat-week-navigation button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
}
