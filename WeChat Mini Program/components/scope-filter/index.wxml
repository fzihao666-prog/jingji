<view class="scope-filter">
  <view class="scope-picker-row">
    <picker class="scope-picker" mode="selector" range="{{projectItems}}" range-key="label" value="{{projectIndex}}" bindchange="onProjectChange">
      <view class="scope-picker-control">
        <text>项目</text>
        <text class="scope-picker-value">{{projectItems[projectIndex].label || '选择项目'}}</text>
        <text>⌄</text>
      </view>
    </picker>
    <picker wx:if="{{showTeam}}" class="scope-picker" mode="selector" range="{{teamItems}}" range-key="name" value="{{teamIndex}}" bindchange="onTeamChange">
      <view class="scope-picker-control">
        <text>队伍</text>
        <text class="scope-picker-value">{{teamItems[teamIndex].name}}</text>
        <text>⌄</text>
      </view>
    </picker>
    <picker wx:if="{{showAthlete}}" class="scope-picker athlete-picker" mode="selector" range="{{athleteItems}}" range-key="name" value="{{athleteIndex}}" bindchange="onAthleteChange">
      <view class="scope-picker-control">
        <text>运动员</text>
        <text class="scope-picker-value">{{athleteItems[athleteIndex].name}}</text>
        <text>⌄</text>
      </view>
    </picker>
  </view>
  <view wx:if="{{showAthlete}}" class="scope-keyword-row">
    <input class="scope-keyword-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="按姓名或队伍筛选" aria-label="按姓名或队伍筛选运动员" />
  </view>
  <view class="scope-range" aria-label="时间范围">
    <button wx:for="{{rangeOptions}}" wx:key="value" class="{{range === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onRangeChange" aria-label="时间范围：{{item.label}}，{{range === item.value ? '已选中' : '未选中'}}">{{item.label}}</button>
  </view>
</view>
