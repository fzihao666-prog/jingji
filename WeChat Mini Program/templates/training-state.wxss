.training-chart-empty { box-sizing: border-box; min-height: 330rpx; border-left: 1rpx solid #cbdadd; border-bottom: 1rpx solid #cbdadd; background: repeating-linear-gradient(to top, transparent 0, transparent 64rpx, #edf2f3 65rpx, transparent 66rpx); }
.training-athlete-search { box-sizing: border-box; width: 100%; min-width: 0; height: 72rpx; margin-bottom: 20rpx; padding: 0 20rpx; border: 1rpx solid #cbdadd; border-radius: 12rpx; font-size: 26rpx; }
.training-athlete-button { display: flex; flex-direction: column; align-items: flex-start; width: 100%; min-width: 0; padding: 16rpx; background: transparent; color: #234d57; text-align: left; font-size: 28rpx; }
.training-athlete-row { width: 100%; min-width: 0; padding: 20rpx 0; text-align: left; line-height: 1.5; background: transparent; border-radius: 0; }
.training-athlete-row::after { border: 0; }
.training-page-status { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; margin-bottom: 16rpx; color: #234d57; font-size: 24rpx; }
.training-page-status > text { flex: 1; min-width: 0; }
.training-page-status .mini-button, .state .mini-button { flex: none; min-height: 64rpx; margin: 12rpx 0 0; padding: 0 24rpx; border: 1rpx solid #cbdadd; border-radius: 12rpx; color: #176f7f; background: #fff; font-size: 24rpx; line-height: 64rpx; }
.training-page-status .mini-button { margin-top: 0; }
.training-page-status .mini-button:focus, .state .mini-button:focus, .training-athlete-row:focus, .training-athlete-button:focus, .training-athlete-search:focus { outline: 4rpx solid #176373; outline-offset: 2rpx; }
