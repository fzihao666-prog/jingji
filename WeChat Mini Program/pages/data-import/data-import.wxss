.import-page {
  padding-bottom: 32rpx;
}

.import-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  overflow-wrap: anywhere;
}

.import-card button {
  margin: 0;
}

.import-template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.import-picker,
.import-review,
.import-editor {
  padding: 18rpx;
  border-radius: var(--radius-item);
  background: var(--mist);
  color: var(--ink);
}

.import-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.import-editor,
.import-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.import-item {
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.import-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.import-filename,
.import-person-title,
.import-subtitle {
  font-weight: 650;
}

.import-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  color: var(--river);
  background: #e9f5f5;
  font-size: 22rpx;
}

.import-attention,
.import-status {
  color: #803f1a;
  font-size: 25rpx;
}
