<view class="page">
  <view class="page-head"><view class="page-title">队伍阅览</view><view class="page-description">{{user.displayName}} · 特邀观察员</view></view>
  <button class="secondary-button" bindtap="openAccount">账号设置</button>
  <view wx:if="{{showAccount}}" class="card">
    <view class="card-head-title">修改密码</view>
    <input class="input" password value="{{currentPassword}}" data-field="currentPassword" bindinput="onPassword" placeholder="当前密码" aria-label="当前密码" />
    <input class="input" password value="{{newPassword}}" data-field="newPassword" bindinput="onPassword" placeholder="至少8位，含字母和数字" aria-label="新密码" />
    <input class="input" password value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onPassword" placeholder="再次输入新密码" aria-label="确认新密码" />
    <view wx:if="{{accountError}}" class="error-box" aria-role="alert">{{accountError}}</view>
    <button class="primary-button" disabled="{{accountBusy}}" loading="{{accountBusy}}" bindtap="changePassword">保存密码</button>
    <button class="secondary-button" bindtap="logout">退出登录</button>
  </view>
  <view wx:if="{{error}}" class="error-box" aria-role="alert">{{error}}<button class="secondary-button" disabled="{{loading}}" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="notice" aria-role="status">正在加载…</view>
  <view wx:if="{{!loading && !teams.length && !error}}" class="card">暂无授权队伍，请联系管理员配置。</view>
  <block wx:if="{{teams.length}}">
    <view class="card">
      <picker range="{{teams}}" range-key="label" value="{{teamIndex}}" disabled="{{loading}}" bindchange="onTeam" aria-label="选择队伍"><view class="input">{{team.label}} ▾</view></picker>
      <view class="observer-filters"><picker mode="date" value="{{from}}" disabled="{{loading}}" data-field="from" bindchange="onDate" aria-label="开始日期"><view class="input">{{from}}</view></picker><picker mode="date" value="{{to}}" disabled="{{loading}}" data-field="to" bindchange="onDate" aria-label="结束日期"><view class="input">{{to}}</view></picker></view>
    </view>
    <view class="section-head"><view class="section-head-title">训练总览</view></view>
    <view class="card observer-grid"><view wx:for="{{overview}}" wx:key="label"><text>{{item.label}}</text><view class="observer-value">{{item.value}}<text>{{item.unit}}</text></view></view></view>
    <view class="section-head"><view class="section-head-title">教练 · {{coaches.length}} 人</view></view>
    <view class="card"><view wx:for="{{coaches}}" wx:key="id" class="observer-row">{{item.displayName}}</view><text wx:if="{{!coaches.length}}">暂无关联教练</text></view>
    <view class="section-head"><view class="section-head-title">运动员 · {{athletes.length}} 人</view></view>
    <view class="card"><view wx:for="{{athletes}}" wx:key="id" class="observer-row"><text>{{item.name}} · {{team.name}}</text><text>负责教练：{{item.coaches || item.headCoaches || '未关联教练'}}</text></view><text wx:if="{{!athletes.length}}">暂无运动员</text></view>
    <view class="section-head"><view class="section-head-title">个人训练与测试</view></view>
    <view wx:if="{{athletes.length}}" class="card"><picker range="{{athletes}}" range-key="name" value="{{athleteIndex}}" disabled="{{loading}}" bindchange="onAthlete" aria-label="选择运动员"><view class="input">{{athlete.name}} ▾</view></picker><button class="secondary-button" bindtap="openReports">查看已有训练报告</button></view>
    <view class="card"><view class="card-head-title">训练明细</view><view wx:for="{{sessions}}" wx:key="id" class="observer-row"><text>{{item.date}} {{item.startTime}} · {{item.trainingType}}</text><text>{{item.content}}</text><text>{{item.durationText}} 分钟 · {{item.distanceText}} km · RPE {{item.rpeText}}</text></view><text wx:if="{{!sessions.length}}">当前范围暂无训练记录</text></view>
    <view class="card"><view class="card-head-title">体能测试</view><view wx:for="{{tests}}" wx:key="id" class="observer-row"><text>{{item.testDate}}</text><text wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="key">{{metric.label}} {{metric.value}} {{metric.unit}}</text></view><text wx:if="{{!tests.length}}">当前范围暂无测试记录</text></view>
    <view class="card"><view class="card-head-title">专项测试</view><view wx:for="{{specialTests}}" wx:key="id" class="observer-row"><text>{{item.testDate}} · {{item.title}}</text><text wx:for="{{item.results}}" wx:for-item="result" wx:key="key">{{result.memberText}} {{result.bestText || result.attemptsText}}</text><text wx:for="{{item.moreResults}}" wx:for-item="result" wx:key="key">{{result.memberText}} {{result.bestText || result.attemptsText}}</text></view><text wx:if="{{!specialTests.length}}">当前范围暂无专项测试</text></view>
    <view class="section-head"><view class="section-head-title">训练计划</view><view wx:if="{{athlete}}" class="section-head-note">{{athlete.name}}的训练安排</view></view>
    <view wx:for="{{plans}}" wx:for-item="plan" wx:key="id" class="card"><view class="card-head-title">{{plan.title}}</view><text>{{plan.startDate}} 至 {{plan.endDate}}</text><view wx:if="{{plan.data.goal}}" class="observer-plan">训练目标：{{plan.data.goal}}</view><view wx:if="{{plan.data.focus}}" class="observer-plan">训练重点：{{plan.data.focus}}</view><view wx:for="{{plan.viewSessions}}" wx:for-item="session" wx:key="id" class="observer-row"><text>{{session.date}} {{session.period}} · {{session.content}}</text><text wx:if="{{session.durationMin != null}}">{{session.durationMin}} 分钟</text><text wx:if="{{session.distanceKm != null}}">{{session.distanceKm}} km</text><text wx:if="{{session.intensity}}">强度 {{session.intensity}}</text><text wx:if="{{session.sets != null || session.reps != null || session.load != null}}">{{session.sets}} 组 · {{session.reps}} 次 · {{session.load}} kg</text><text wx:for="{{session.items}}" wx:for-item="content" wx:key="id">{{content.title}} {{content.description}}</text></view></view>
    <view wx:if="{{!plans.length}}" class="card">暂无训练计划</view>
  </block>
  <icp-filing />
</view>
