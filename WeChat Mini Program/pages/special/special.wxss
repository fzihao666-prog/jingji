.team-picker { display: block; margin: -6rpx 0 18rpx; }
.team-picker-control { height: 66rpx; padding: 0 18rpx; border: 1rpx solid #d5e1e3; border-radius: 15rpx; display: flex; align-items: center; gap: 12rpx; background: #ffffff; }
.team-picker-control > text:first-child { color: #829399; font-size: 20rpx; }
.team-picker-value { min-width: 0; flex: 1; overflow: hidden; color: #1d4d58; font-size: 23rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.team-picker-control > text:last-child { color: #6f848b; }
.champion-list { display: grid; }
.champion-row { min-height: 112rpx; padding: 18rpx 0; border-bottom: 1rpx solid #e2eaeb; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.champion-row:last-child { border-bottom: 0; }
.champion-value { flex: none; text-align: right; }
.champion-performance { display: block; color: #0f5961; font-size: 27rpx; font-weight: 700; }
.champion-value text { display: block; margin-top: 5rpx; color: #bd7418; font-size: 19rpx; }
.special-trend { min-width: 690rpx; }
.athlete-summary { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; color: #5e7780; font-size: 19rpx; }

.section-head-row { margin-top: 7rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-head-row .section-head-note { margin-top: 0; }
.section-head-row .mini-button { flex: none; min-width: 108rpx; height: 58rpx; margin: 0; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #cbdadd; border-radius: 14rpx; color: #176f7f; background: #fff; font-size: 21rpx; line-height: 1; }
.section-head-row .mini-button:focus { outline: 4rpx solid #176373; outline-offset: 2rpx; }

/* 专项测试成绩：事件分组 + 名次/组合/成绩三列，最好成绩为视觉锚点。 */
.test-event { padding: 22rpx 0; border-bottom: 1rpx solid #e2eaeb; }
.test-event:last-child { border-bottom: 0; }
.test-event-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.test-event-title { min-width: 0; color: #123f49; font-size: 26rpx; font-weight: 700; overflow-wrap: anywhere; }
.test-event-date { flex: none; color: #70858c; font-size: 20rpx; }
.test-event-meta { display: block; margin-top: 6rpx; color: #829398; font-size: 19rpx; }
.test-event-results { margin-top: 12rpx; display: grid; gap: 8rpx; }
.test-result { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; column-gap: 14rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: #f8fbfb; }
.test-result-rank { min-width: 40rpx; height: 40rpx; padding: 0 8rpx; border-radius: 999rpx; background: #e3edee; color: #5e7780; font-size: 20rpx; font-weight: 700; line-height: 40rpx; text-align: center; }
.test-result-crew { min-width: 0; }
.test-crew { display: block; color: #123f49; font-size: 24rpx; font-weight: 700; overflow-wrap: anywhere; }
.test-members { display: block; margin-top: 2rpx; color: #829398; font-size: 19rpx; overflow-wrap: anywhere; }
.test-result-detail { min-width: 0; text-align: right; }
.test-best { display: block; color: #0f5961; font-size: 30rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.test-attempts { display: block; margin-top: 2rpx; color: #70858c; font-size: 19rpx; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.test-delta { display: inline-block; margin-top: 6rpx; padding: 2rpx 12rpx; border-radius: 999rpx; font-size: 18rpx; font-variant-numeric: tabular-nums; }
.test-delta.faster { background: #e2f0e9; color: #2b6e58; }
.test-delta.slower { background: #f6e3e1; color: #9c3f37; }
.test-delta.flat { background: #e8eff0; color: #70858c; }
