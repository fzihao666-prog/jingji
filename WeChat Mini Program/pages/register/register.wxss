.register-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f2f6f6;
}

.register-topbar {
  flex: none;
  padding: calc(var(--status-bar-height, 44px) + 16rpx) 30rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #092b39;
}

.back-link {
  padding: 8rpx 4rpx;
  color: #7fe8df;
  font-size: 24rpx;
  font-weight: 700;
}

.back-link-active { opacity: .6; }

.register-brand {
  display: flex;
  align-items: center;
}

.register-logo {
  width: 120rpx;
  padding: 6rpx 8rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .97);
}

.register-scroll {
  min-height: 0;
  flex: 1;
}

.register-box {
  width: 100%;
  margin: 0 auto;
  padding: 28rpx 30rpx 56rpx;
}

.register-heading {
  margin: 0 7rpx 22rpx;
  display: flex;
  flex-direction: column;
}

.register-kicker {
  color: #1b9d95;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.register-title {
  margin: 8rpx 0 6rpx;
  color: #092b39;
  font-size: 40rpx;
  font-weight: 800;
}

.register-description {
  color: #778b92;
  font-size: 21rpx;
  line-height: 1.5;
}

.register-form {
  width: 100%;
  padding: 28rpx 26rpx 30rpx;
  border: 1rpx solid #dbe6e8;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(9, 43, 57, .07);
}

.section-title {
  margin: 10rpx 0 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title:first-child { margin-top: 0; }

.section-title b {
  min-width: 44rpx;
  height: 36rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #ffffff;
  background: #176f7f;
  font-size: 18rpx;
  font-weight: 800;
}

.section-title strong {
  color: #092b39;
  font-size: 24rpx;
  font-weight: 800;
}

.field { margin-bottom: 22rpx; }

.field-label {
  display: block;
  margin-bottom: 9rpx;
  color: #3c555e;
  font-size: 21rpx;
  font-weight: 700;
}

.input {
  height: 84rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cedcdf;
  border-radius: 14rpx;
  background: #f9fbfb;
  color: #092b39;
  font-size: 26rpx;
}

.input-readonly {
  color: #778b92;
  background: #f1f5f6;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.picker-value {
  height: 84rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #cedcdf;
  border-radius: 14rpx;
  background: #f9fbfb;
  color: #092b39;
  font-size: 26rpx;
}

.picker-value.placeholder { color: #9aabaf; }

.register-error {
  margin-top: 6rpx;
  padding: 17rpx 19rpx;
  border-left: 5rpx solid #e65d43;
  color: #9a4639;
  background: #fff1ee;
  font-size: 21rpx;
  line-height: 1.5;
}

.register-success {
  margin-top: 6rpx;
  padding: 17rpx 19rpx;
  border-left: 5rpx solid #1b9d95;
  color: #0d5f5a;
  background: #eafaf7;
  font-size: 21rpx;
  line-height: 1.5;
}

.register-button {
  width: 100%;
  min-width: 100%;
  height: 88rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  background: linear-gradient(105deg, #075364, #0b686a);
  box-shadow: 0 14rpx 28rpx rgba(6, 75, 85, .2);
}

.register-footer {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.footer-link {
  padding: 8rpx 16rpx;
  color: #176f7f;
  font-size: 22rpx;
  font-weight: 700;
}
