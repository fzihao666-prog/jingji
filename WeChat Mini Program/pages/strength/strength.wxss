.comparison-list { display: grid; gap: 14rpx; }
.comparison-card { padding: 20rpx; border: 1rpx solid #dce6e8; border-radius: 17rpx; background: #f9fcfc; }
.comparison-name { color: #234d57; font-size: 24rpx; font-weight: 800; }
.comparison-values { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.comparison-values view { min-width: 0; }
.comparison-values text { display: block; color: #7b8d94; font-size: 18rpx; }
.comparison-values text:last-child { margin-top: 5rpx; overflow: hidden; color: #365d66; font-size: 21rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.comparison-values .comparison-rate { color: #176f7f; }
.comparison-list .notice { margin-top: 4rpx; }
.plan-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.plan-head text { display: block; margin-top: 7rpx; color: #7d9097; font-size: 20rpx; }
.plan-head > text { flex: none; color: #176f7f; }
.plan-summary { margin: 20rpx 0; }
.strength-trend { min-width: 690rpx; }

.section-head-row { margin-top: 7rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-head-row .section-head-note { margin-top: 0; }
.section-head-row .mini-button { flex: none; min-width: 108rpx; height: 58rpx; margin: 0; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #cbdadd; border-radius: 14rpx; color: #176f7f; background: #fff; font-size: 21rpx; line-height: 1; }
.section-head-row .mini-button:focus { outline: 4rpx solid #176373; outline-offset: 2rpx; }
