.privacy-notice { margin: -4rpx 2rpx 18rpx; display: flex; align-items: center; gap: 9rpx; color: #6f858d; font-size: 20rpx; }
.privacy-notice image { width: 32rpx; height: 32rpx; flex: none; }
.more-grid { margin-top: 1rpx; }
.profile-more { width: 100%; margin-top: 12rpx; }
.benchmark-score { margin-bottom: 20rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.benchmark-score > view { padding: 22rpx; border-top: 6rpx solid #168f88; background: #f7faf9; }
.benchmark-score text { display: block; color: #70858c; font-size: 20rpx; }
.benchmark-value { display: block; margin-top: 10rpx; color: #0f5961; font-size: 40rpx; font-weight: 700; }
.notice-line { display: block; margin-top: 6rpx; }
.injury-note { display: block; margin-top: 14rpx; color: #617880; font-size: 20rpx; line-height: 1.6; }
.profile-hero { position: relative; padding-right: 120rpx; }
.profile-hero-info { min-width: 0; flex: 1; }
.hero-edit-button { position: absolute; top: 20rpx; right: 20rpx; height: 58rpx; margin: 0; padding: 0 15rpx; display: flex; align-items: center; gap: 7rpx; border: 1rpx solid #c9dcde; border-radius: 29rpx; color: #176f7f; background: #f7fbfb; font-size: 20rpx; font-weight: 700; line-height: 1; }
.hero-edit-icon { font-size: 25rpx; font-weight: 400; }
.injury-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.injury-head-copy { min-width: 0; flex: 1; }
.injury-report-entry { flex: none; margin: 0; padding: 8rpx 0; white-space: nowrap; }
.coach-fill-actions { display: flex; gap: 16rpx; }
.coach-fill-actions .secondary-button { flex: 1; margin: 0; min-height: 76rpx; font-size: 23rpx; }
/* 疼痛趋势卡：只读柱条，样式自包含（card-title/todo-note 在本页无全局定义，局部补齐） */
.pain-trend .card-title { color: #164751; font-size: 28rpx; font-weight: 800; }
.pain-trend .todo-note { margin-top: 6rpx; color: #819399; font-size: 20rpx; line-height: 1.5; }
.pain-part { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #e3edef; }
.pain-part-head { display: flex; align-items: center; gap: 14rpx; }
.pain-part-name { min-width: 0; flex: 1; color: #12303b; font-size: 26rpx; font-weight: 700; }
.pain-part-latest { flex: none; color: #7a4715; font-size: 22rpx; }
.pain-bars-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.pain-bars { display: flex; align-items: flex-end; gap: 6rpx; height: 140rpx; padding: 4rpx 2rpx; }
.pain-bar { width: 18rpx; min-height: 8rpx; margin: 0; padding: 0; border: 0; border-radius: 8rpx 8rpx 2rpx 2rpx; background: #70b9b2; line-height: inherit; }
.pain-bar::after { border: 0; }
.pain-bar:focus { box-shadow: inset 0 0 0 4rpx #0b706b; }

/* 数据图表通用注记：口径说明直接放在卡片头，避免误读归一柱高 */
.chart-note { display: block; margin-top: 6rpx; color: #819399; font-size: 20rpx; line-height: 1.5; }

/* 身体成分指标趋势：柱高按指标自身波动范围归一，点击柱体看单点明细 */
.trend-metric { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #e3edef; }
.trend-metric-head { display: flex; align-items: baseline; gap: 12rpx; }
.trend-metric-name { min-width: 0; flex: 1; color: #12303b; font-size: 25rpx; font-weight: 700; }
.trend-metric-value { color: #0f5961; font-size: 30rpx; font-weight: 800; }
.trend-metric-unit { margin-left: 4rpx; color: #70858c; font-size: 20rpx; font-weight: 400; }
.trend-delta { flex: none; color: #70858c; font-size: 20rpx; }
.trend-delta.up { color: #b26516; }
.trend-delta.down { color: #168f88; }
.trend-scroll { width: 100%; margin-top: 12rpx; white-space: nowrap; }
.trend-bars { display: flex; align-items: flex-end; gap: 10rpx; height: 130rpx; padding: 4rpx 2rpx; }
.trend-bar { width: 26rpx; min-height: 8rpx; margin: 0; padding: 0; border: 0; border-radius: 8rpx 8rpx 2rpx 2rpx; background: #70b9b2; line-height: inherit; }
.trend-bar::after { border: 0; }
.trend-bar.is-missing { border: 1rpx dashed #b9cdd1; background: #eef4f5; }
.trend-bar:focus { box-shadow: inset 0 0 0 4rpx #0b706b; }

/* 身体成分：同类指标并排合并，分组按需展开。 */
.body-group { padding: 0; overflow: hidden; }
.body-group-toggle { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; width: 100%; margin: 0; padding: 24rpx 26rpx; border-radius: 24rpx; background: #ffffff; text-align: left; line-height: 1.5; }
.body-group-heading { min-width: 0; flex: 1; }
.body-group-title { display: block; color: #164751; font-size: 28rpx; font-weight: 800; }
.body-group-summary { display: block; margin-top: 6rpx; color: #526b74; font-size: 21rpx; }
.body-group-action { flex: none; color: #176f7f; font-size: 22rpx; font-weight: 700; }
.body-group-content { padding: 0 26rpx 24rpx; }
.body-metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.body-metric { min-width: 0; padding: 20rpx 16rpx; border: 1rpx solid #d8e3e6; border-radius: 18rpx; background: #f7fbfb; }
.body-metric-name { display: block; color: #12303b; font-size: 23rpx; font-weight: 700; }
.body-metric-value { margin-top: 10rpx; color: #0f5961; font-size: 34rpx; font-weight: 800; overflow-wrap: anywhere; }
.body-metric-unit { margin-left: 6rpx; color: #526b74; font-size: 20rpx; font-weight: 400; }
.body-metric-delta, .body-metric-date, .body-metric-note { display: block; margin-top: 8rpx; color: #526b74; font-size: 20rpx; line-height: 1.5; }
.body-metric-scroll { width: 100%; margin-top: 14rpx; }
.body-metric-bars { display: flex; align-items: flex-end; height: 100rpx; }
.body-point { display: flex; flex: none; align-items: flex-end; justify-content: center; width: 48rpx; min-width: 24px; height: 100%; margin: 0; padding: 4rpx; border-radius: 8rpx; background: transparent; line-height: inherit; }
.body-point-fill { width: 26rpx; min-height: 8rpx; border-radius: 8rpx 8rpx 2rpx 2rpx; background: #168f88; }
.body-point-fill.is-missing { border: 1rpx dashed #526b74; background: #eef4f5; }
.body-group-toggle:focus, .body-point:focus { box-shadow: inset 0 0 0 4rpx #0b706b; }
.body-group-note { display: block; margin-top: 16rpx; color: #526b74; font-size: 20rpx; line-height: 1.6; }

/* 训练情况对比：个人与队均双条，同指标内归一 */
.compare-row { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #e3edef; }
.compare-head { display: flex; align-items: baseline; gap: 12rpx; }
.compare-name { min-width: 0; flex: 1; color: #12303b; font-size: 25rpx; font-weight: 700; }
.compare-diff { flex: none; color: #70858c; font-size: 22rpx; font-weight: 700; }
.compare-diff.up { color: #b26516; }
.compare-diff.down { color: #168f88; }
.compare-line { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.compare-tag { width: 58rpx; flex: none; color: #70858c; font-size: 20rpx; }
.compare-track { min-width: 0; flex: 1; height: 22rpx; overflow: hidden; border-radius: 12rpx; background: #eef4f5; }
.compare-fill { height: 100%; border-radius: 12rpx; }
.compare-fill.personal { background: #168f88; }
.compare-fill.team { background: #a8c0c9; }
.compare-value { width: 128rpx; flex: none; color: #12303b; font-size: 21rpx; text-align: right; }
.compare-note { display: block; margin-top: 10rpx; color: #819399; font-size: 19rpx; }

/* 训练对比卡片：数值置于条形上方，窄屏下不挤压对比图。 */
.comparison-difference { margin-top: 10rpx; color: #0f5961; font-size: 26rpx; font-weight: 800; overflow-wrap: anywhere; }
.comparison-value-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6rpx 10rpx; margin-top: 14rpx; color: #526b74; font-size: 20rpx; line-height: 1.5; }
.comparison-value { min-width: 0; color: #12303b; font-weight: 700; overflow-wrap: anywhere; }
.comparison-metric .compare-track { width: 100%; margin-top: 6rpx; }

/* 雷达模型对照：canvas 2d 多边形 + 维度明细兜底 */
.radar-legend { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.radar-legend-item { padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 19rpx; }
.radar-legend-item.personal { color: #0f5961; background: rgba(22, 143, 136, 0.12); }
.radar-legend-item.reference { color: #7a4715; background: rgba(215, 150, 23, 0.14); }
.radar-legend-item.scale { color: #70858c; background: #eef4f5; }
.radar-canvas { width: 100%; height: 480rpx; margin-top: 12rpx; }
.radar-fallback { margin-top: 12rpx; padding: 34rpx 20rpx; border: 1rpx dashed #c9dcde; border-radius: 12rpx; color: #70858c; font-size: 21rpx; text-align: center; }
.radar-dim { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #e3edef; }
.radar-dim-values { display: flex; flex: 1; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 12rpx; }
.radar-dim-value { color: #0f5961; font-size: 23rpx; font-weight: 700; }
.radar-dim-ref { color: #70858c; font-size: 19rpx; }
.radar-dim-achieved { color: #168f88; font-size: 21rpx; font-weight: 700; }
