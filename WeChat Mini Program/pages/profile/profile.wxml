<view class="page">
  <view class="page-head">
    <view class="page-title">运动员档案</view>
    <view class="page-description">个人画像、训练、测试与伤病恢复</view>
  </view>

  <scope-filter projects="{{projects}}" project="{{project}}" athletes="{{athletes}}" athlete-id="{{selectedAthleteId}}" show-athlete="{{showAthlete}}" allow-all="{{false}}" range="{{range}}" bindprojectchange="onScopeChange" bindathletechange="onScopeChange" bindrangechange="onScopeChange" />
  <view class="privacy-notice"><image src="/assets/shield-check.svg" mode="aspectFit" />敏感信息已按权限脱敏展示</view>
  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view wx:if="{{loading}}" class="card state"><view class="state-icon">↻</view><view class="state-title">正在加载运动员档案</view></view>

  <block wx:if="{{!loading && selectedAthleteId}}">
    <view class="card profile-hero">
      <view class="profile-photo"><image wx:if="{{photoUrl}}" src="{{photoUrl}}" mode="aspectFill" /><view wx:else class="profile-photo-placeholder">{{athleteInitial}}</view></view>
      <view class="profile-hero-info"><view class="profile-name">{{athleteName}}</view><text class="profile-line">{{athleteMeta}}</text><text class="profile-line">{{athleteSubline}}</text></view>
      <button wx:if="{{canEditSelf}}" class="hero-edit-button" bindtap="editMyProfile"><text class="hero-edit-icon">✎</text><text>编辑</text></button>
    </view>

    <view class="section-head"><view class="section-head-title">基本信息</view><view class="section-head-note">常用资料优先展示</view></view>
    <view class="profile-grid"><view wx:for="{{primaryCells}}" wx:key="label" class="profile-cell"><view class="profile-cell-label">{{item.label}}</view><text class="profile-cell-value">{{item.value}}</text></view></view>
    <view wx:if="{{showMore}}" class="profile-grid more-grid"><view wx:for="{{moreCells}}" wx:key="label" class="profile-cell"><view class="profile-cell-label">{{item.label}}</view><text class="profile-cell-value">{{item.value}}</text></view></view>
    <button class="text-button profile-more" bindtap="toggleMore">{{showMore ? '收起更多资料' : '查看更多资料'}}</button>

    <view class="section-head"><view class="section-head-title">训练与数据概览</view><view class="section-head-note">{{from}} 至 {{to}}</view></view>
    <view class="compact-grid"><view wx:for="{{trainingSummary}}" wx:key="label" class="compact-stat"><view class="compact-stat-label">{{item.label}}</view><view class="compact-stat-value">{{item.value}}<text>{{item.unit}}</text></view><text class="compact-stat-note">{{item.note}}</text></view></view>

    <view class="section-head"><view class="section-head-title">制胜要素分析</view><view class="section-head-note">目标达成制，不用于选材或伤病诊断</view></view>
    <view class="card">
      <block wx:if="{{benchmarkSummary}}"><view class="benchmark-score"><view><text>综合结果</text><text class="benchmark-value">{{benchmarkSummary.score}}</text></view><view><text>达成指标</text><text class="benchmark-value">{{benchmarkSummary.achieved}}/{{benchmarkSummary.comparable}}</text></view></view><view class="notice"><text>主要差距：{{benchmarkSummary.primaryGap}}</text><text class="notice-line">数据来源：{{benchmarkSummary.source}}</text></view></block>
      <view wx:else class="state"><view class="state-icon">—</view><view class="state-title">暂无可比冠军模型数据</view></view>
    </view>

    <view class="section-head"><view class="section-head-title">力量测试个人评价</view><view class="section-head-note">最近测试 {{latestTestDate || '未录入'}}</view></view>
    <view class="card"><view wx:if="{{testMetrics.length}}" class="ratio-list"><view wx:for="{{testMetrics}}" wx:key="key"><view class="ratio-row-head"><text>{{item.label}} · {{item.value}}{{item.unit}}</text><text>{{item.rate}}</text></view><view class="ratio-track"><view class="ratio-fill" style="width: {{item.rateWidth}}%;" /></view></view></view><view wx:else class="state"><view class="state-icon">—</view><view class="state-title">暂无力量测试数据</view></view></view>

    <view class="section-head injury-head">
      <view class="injury-head-copy">
        <view class="section-head-title">运动损伤与恢复</view>
        <view class="section-head-note">仅展示当前运动员有权查看的记录</view>
      </view>
      <button wx:if="{{selectedAthleteId && canReportRole}}" class="text-button injury-report-entry" bindtap="reportInjury" aria-label="{{canEditSelf ? '提交本人疼痛反馈' : '为当前运动员新增伤病记录'}}">{{canEditSelf ? '提交疼痛反馈' : '新增伤病记录'}}</button>
    </view>
    <view wx:if="{{selectedAthleteId && canCoachFill}}" class="card coach-fill-card">
      <view class="card-head"><view><view class="card-head-title">教练代填</view><view class="todo-note">为当前运动员补充训练课次或恢复日报</view></view></view>
      <view class="coach-fill-actions">
        <button class="secondary-button" bindtap="fillTraining" aria-label="为当前运动员代填训练记录">代填训练</button>
        <button class="secondary-button" bindtap="fillWellness" aria-label="为当前运动员代填恢复日报">代填日报</button>
      </view>
    </view>
    <view class="card"><view wx:if="{{injuries.length}}" class="list"><view wx:for="{{injuries}}" wx:key="id" class="list-row"><view class="list-row-main"><view><view class="list-row-title">{{item.title}}</view><text class="list-row-meta">{{item.meta}}</text></view><view class="list-row-value">{{item.pain}}</view></view><text class="tag {{item.statusClass}}">{{item.status}}</text><text class="injury-note">{{item.restriction}}</text></view></view><view wx:else class="state"><view class="state-icon">✓</view><view class="state-title">暂无伤病记录</view></view></view>
    <view wx:if="{{painTrend}}" class="card pain-trend" aria-label="疼痛趋势">
      <view class="card-head"><view><view class="card-title">疼痛趋势 · 近 {{painTrend.days}} 天</view><view class="todo-note">按部位展示每日最新疼痛评分，点击柱体查看明细</view></view></view>
      <view wx:for="{{painTrend.parts}}" wx:for-item="part" wx:for-index="partIndex" wx:key="bodyPart" class="pain-part">
        <view class="pain-part-head">
          <text class="pain-part-name">{{part.bodyPart}}</text>
          <text class="tag {{part.statusClass}}">{{part.statusLabel}}</text>
          <text class="pain-part-latest">最新疼痛 {{part.latestPain}}</text>
        </view>
        <scroll-view class="pain-bars-scroll" scroll-x enhanced show-scrollbar="false">
          <view class="pain-bars">
            <button wx:for="{{part.bars}}" wx:for-item="bar" wx:for-index="barIndex" wx:key="date" class="pain-bar" style="height: {{bar.height}}%;" data-part-index="{{partIndex}}" data-bar-index="{{barIndex}}" bindtap="showPainDetail" aria-label="{{part.bodyPart}}，{{bar.date}}，疼痛 {{bar.pain}} 分，查看明细"></button>
          </view>
        </scroll-view>
      </view>
    </view>
    <view class="section-head"><view class="section-head-title">恢复状态</view><view class="section-head-note">{{from}} 至 {{to}}</view></view>
    <view wx:if="{{loading}}" class="card state"><view class="state-icon">↻</view><view class="state-title">正在读取恢复趋势</view></view>
    <view wx:elif="{{error}}" class="card state"><view class="state-icon">⚠</view><view class="state-title">{{error}}</view></view>
    <view wx:elif="{{!wellnessTrends.length}}" class="card state"><view class="state-icon">—</view><view class="state-title">暂无恢复趋势数据</view></view>
    <view wx:else class="card"><view class="card-head"><view class="card-title">恢复趋势</view></view><view class="card-body"><view wx:for="{{wellnessTrends}}" wx:key="label"><view class="card-item"><text class="card-label">{{item.label}}</text><text class="card-value">{{item.hasPersonal ? item.personalValue : '—'}}{{item.unit}}{{item.teamMean != null ? '（队均' + item.teamMean + item.unit + '）' : ''}}</text></view></view></view></view>
    <view class="section-head"><view class="section-head-title">身体成分</view><view class="section-head-note">最近 6 次实测 · 分组展开查看</view></view>
    <view wx:if="{{loading}}" class="card state"><view class="state-icon">↻</view><view class="state-title">正在读取身体成分</view></view>
    <view wx:elif="{{error}}" class="card state"><view class="state-icon">⚠</view><view class="state-title">{{error}}</view></view>
    <view wx:elif="{{!bodyCompositionHistory.length}}" class="card state"><view class="state-icon">—</view><view class="state-title">暂无身体成分记录</view></view>
    <view wx:else class="body-composition">
      <view wx:for="{{bodyCompositionGroups}}" wx:for-item="group" wx:key="key" class="card body-group">
        <button class="body-group-toggle" data-group-key="{{group.key}}" bindtap="toggleBodyCompositionGroup" aria-expanded="{{group.expanded}}" aria-label="{{group.label}}，{{group.expanded ? '收起' : '展开'}}">
          <view class="body-group-heading"><text class="body-group-title">{{group.label}}</text><text class="body-group-summary">{{group.summary}}</text></view>
          <text class="body-group-action">{{group.expanded ? '收起 −' : '展开 +'}}</text>
        </button>
        <view wx:if="{{group.expanded}}" class="body-group-content">
          <view class="body-metric-grid">
            <view wx:for="{{group.metrics}}" wx:for-item="metric" wx:key="key" class="body-metric">
              <text class="body-metric-name">{{metric.label}}</text>
              <view class="body-metric-value">{{metric.latest}}<text class="body-metric-unit">{{metric.unit}}</text></view>
              <text class="body-metric-delta">较上次 {{metric.delta != null ? (metric.delta > 0 ? '+' : '') + metric.delta + metric.unit : '—'}}</text>
              <scroll-view wx:if="{{metric.recorded > 1}}" class="body-metric-scroll" scroll-x enhanced show-scrollbar="false">
                <view class="body-metric-bars">
                  <button wx:for="{{metric.points}}" wx:for-item="point" wx:for-index="pointIndex" wx:key="date" class="body-point" data-metric-index="{{metric.metricIndex}}" data-point-index="{{pointIndex}}" bindtap="showBodyCompositionDetail" aria-label="{{metric.label}}，{{point.missing ? point.date + '，该日期未测' : point.date + '，实测 ' + point.value + metric.unit}}，查看明细"><view class="body-point-fill {{point.missing ? 'is-missing' : ''}}" style="height: {{point.missing ? 8 : point.height}}%;" /></button>
                </view>
              </scroll-view>
              <text wx:else class="body-metric-note">仅 1 次实测，暂无趋势</text>
              <text class="body-metric-date">最近实测 {{metric.latestDate}}</text>
            </view>
          </view>
          <text class="body-group-note">点击柱体查看明细；柱高按各指标自身波动范围归一，缺测留空。</text>
        </view>
      </view>
    </view>
    <view class="section-head"><view class="section-head-title">训练情况对比</view><view class="section-head-note">{{from}} 至 {{to}} · 团队平均对照</view></view>
    <view wx:if="{{loading}}" class="card state"><view class="state-icon">↻</view><view class="state-title">正在读取训练对比</view></view>
    <view wx:elif="{{error}}" class="card state"><view class="state-icon">⚠</view><view class="state-title">{{error}}</view></view>
    <view wx:elif="{{!comparisonView.items.length}}" class="card state"><view class="state-icon">—</view><view class="state-title">暂无训练对比数据</view></view>
    <view wx:else class="training-comparison">
      <view wx:for="{{trainingComparisonGroups}}" wx:for-item="group" wx:key="key" class="card body-group">
        <button class="body-group-toggle" data-group-key="{{group.key}}" bindtap="toggleTrainingComparisonGroup" aria-expanded="{{group.expanded}}" aria-label="{{group.label}}，{{group.expanded ? '收起' : '展开'}}">
          <view class="body-group-heading"><text class="body-group-title">{{group.label}}</text><text class="body-group-summary">{{group.summary}}</text></view>
          <text class="body-group-action">{{group.expanded ? '收起 −' : '展开 +'}}</text>
        </button>
        <view wx:if="{{group.expanded}}" class="body-group-content">
          <view class="body-metric-grid">
            <view wx:for="{{group.metrics}}" wx:for-item="metric" wx:key="key" class="body-metric comparison-metric">
              <text class="body-metric-name">{{metric.label}}</text>
              <view class="comparison-difference">差值 {{metric.diffText}}<text class="body-metric-unit">{{metric.diffText != '—' ? metric.unit : ''}}</text></view>
              <view class="comparison-value-line"><text>个人</text><text class="comparison-value">{{metric.personalText}}{{metric.personalText != '—' ? metric.unit : ''}}</text></view>
              <view class="compare-track" aria-hidden="true"><view class="compare-fill personal" style="width: {{metric.personalPct}}%;"></view></view>
              <view class="comparison-value-line"><text>队均</text><text class="comparison-value">{{metric.teamText}}{{metric.teamText != '—' ? metric.unit : ''}}</text></view>
              <view class="compare-track" aria-hidden="true"><view class="compare-fill team" style="width: {{metric.teamPct}}%;"></view></view>
              <text class="body-metric-note">{{metric.note}}</text>
            </view>
          </view>
          <text class="body-group-note">条长按同指标较大值归一；差值 = 个人 − 队均，缺失保留“—”，不代表训练优劣。</text>
        </view>
      </view>
    </view>
    <view class="section-head"><view class="section-head-title">雷达模型对照</view><view class="section-head-note">{{from}} 至 {{to}} · 正式参考标准</view></view>
    <view wx:if="{{loading}}" class="card state"><view class="state-icon">↻</view><view class="state-title">正在读取雷达模型</view></view>
    <view wx:elif="{{error}}" class="card state"><view class="state-icon">⚠</view><view class="state-title">{{error}}</view></view>
    <view wx:elif="{{!radarGroups.length}}" class="card state"><view class="state-icon">—</view><view class="state-title">暂无雷达模型数据</view></view>
    <block wx:else>
      <view wx:for="{{radarGroups}}" wx:key="canvasId" class="card radar-card">
        <view class="card-head"><view><view class="card-title">{{item.title}}</view><text class="chart-note">参考标准多边形固定 100%，个人按达成度绘制；缺失维度处断线，详细数值见下表</text></view></view>
        <view class="radar-legend">
          <text class="radar-legend-item personal">个人达成度</text>
          <text class="radar-legend-item reference">参考标准 100%</text>
          <text class="radar-legend-item scale">上限 {{item.maxValue}}%</text>
        </view>
        <canvas wx:if="{{item.hasChart}}" type="2d" id="{{item.canvasId}}" canvas-id="{{item.canvasId}}" class="radar-canvas" aria-label="{{item.title}}：个人达成度与参考标准对照雷达图，详细数值见下方列表"></canvas>
        <view wx:else class="radar-fallback">有效维度不足 3 个，暂不绘制雷达多边形</view>
        <view class="card-body">
          <view wx:for="{{item.dimensions}}" wx:for-item="dim" wx:key="key" class="radar-dim">
            <text class="card-label">{{dim.label}}</text>
            <view class="radar-dim-values">
              <text class="radar-dim-value">{{dim.valueText}}</text>
              <text class="radar-dim-ref">参考 {{dim.referenceText}}</text>
              <text class="radar-dim-achieved">{{dim.achievedText}}</text>
              <text class="tag {{dim.statusLabel == '已测' ? '' : 'warn'}}">{{dim.statusLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </block>
  <view wx:if="{{!loading && !selectedAthleteId && showAthlete && !athletes.length}}" class="card state"><view class="state-icon">—</view><view class="state-title">当前项目暂无可查看运动员</view><view class="state-note">请联系管理员确认队伍与项目权限</view></view>
  <view wx:elif="{{!loading && !selectedAthleteId && !showAthlete}}" class="card state"><view class="state-icon">人</view><view class="state-title">当前账号未绑定运动员档案</view></view>
  <view wx:elif="{{!loading && !selectedAthleteId}}" class="card state"><view class="state-icon">人</view><view class="state-title">请选择运动员</view></view>
</view>
