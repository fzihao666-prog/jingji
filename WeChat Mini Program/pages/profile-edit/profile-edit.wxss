.form-page { padding-bottom: 190rpx; }
.photo-card { display: flex; align-items: center; gap: 20rpx; }
.edit-photo { width: 104rpx; height: 126rpx; flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #176f7f; background: #e5f1f1; font-weight: 700; }
.edit-photo image { width: 100%; height: 100%; }
.form-note { display: block; margin-top: 8rpx; color: #49656c; font-size: 20rpx; line-height: 1.5; }
.chevron { margin-left: auto; color: #789097; font-size: 48rpx; }
.form-card { padding-bottom: 6rpx; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16rpx; }
.form-grid.triple { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.picker-input { height: 86rpx; padding: 0 22rpx; display: flex; align-items: center; border: 1rpx solid #ccdadd; border-radius: 16rpx; background: #fff; font-size: 25rpx; }
.readonly-value { height: 86rpx; padding: 0 22rpx; display: flex; align-items: center; border: 1rpx dashed #94aab0; border-radius: 16rpx; background: #eef3f4; color: #49656c; font-size: 25rpx; }
.textarea { width: 100%; min-height: 150rpx; padding: 20rpx 22rpx; border: 1rpx solid #ccdadd; border-radius: 16rpx; background: #fff; font-size: 25rpx; line-height: 1.55; }
.body-more { width: 100%; margin: -2rpx 0 16rpx; }
.body-extra { padding-top: 18rpx; border-top: 1rpx solid #e3ebed; }
.save-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #d9e4e6; background: rgba(255,255,255,.96); }
.save-bar .primary-button { max-width: 652rpx; margin: 0 auto; }
