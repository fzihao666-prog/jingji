<view class="page">
  <view class="page-head page-head-action">
    <view class="page-head-copy">
      <view class="page-title">{{meta.scope === 'individual' ? '我的训练总览' : '训练总览'}}</view>
      <view class="page-description">{{from}} 至 {{to}} · {{projectLabel}}</view>
    </view>
    <button wx:if="{{canSelfReport}}" class="quick-entry" hover-class="quick-entry-active" bindtap="openTrainingEntry"><text class="quick-entry-icon">＋</text><text>记录训练</text></button>
  </view>

  <scope-filter projects="{{projects}}" project="{{project}}" athletes="{{athletes}}" athlete-id="{{selectedAthleteId}}" show-athlete="{{showAthlete}}" range="{{range}}" bindprojectchange="onScopeChange" bindathletechange="onScopeChange" bindrangechange="onScopeChange" />

  <view wx:if="{{canSelfReport && (todayView || todayLoading || todayError)}}" class="card today-status" aria-label="今日状态">
    <view class="card-head">
      <view><view class="card-head-title">今日状态</view><view class="todo-note">{{todayView ? todayView.date + ' · 北京时间' : '北京时间'}}</view></view>
      <button class="todo-refresh" bindtap="retryToday" disabled="{{todayLoading}}" aria-label="刷新今日状态">刷新</button>
    </view>
    <view wx:if="{{todayLoading && !todayView}}" class="todo-note" aria-role="status" aria-live="polite" aria-atomic="true">正在读取今日状态…</view>
    <view wx:if="{{todayError}}" class="error-box">{{todayError}}</view>
    <block wx:if="{{todayView}}">
      <view class="today-row">
        <view class="today-main">
          <view class="today-state {{todayView.submitted ? 'today-state-ok' : 'today-state-warn'}}">{{todayView.submittedLabel}}</view>
          <view class="todo-note">{{todayView.note}}</view>
          <view wx:if="{{todayView.timeNote}}" class="todo-note">{{todayView.timeNote}}</view>
        </view>
        <view class="today-load">
          <view class="today-load-value">{{todayView.loadText}}<text class="today-load-unit">AU</text></view>
          <text class="today-load-label">24小时负荷</text>
        </view>
      </view>
      <view wx:if="{{todayView.sourceText}}" class="todo-note">{{todayView.sourceText}}</view>
      <view wx:if="{{wellnessView}}" class="today-wellness">
        <view class="todo-row-head"><text>恢复日报 · {{wellnessView.filledLabel}}</text></view>
        <view class="todo-note">{{wellnessView.note}}</view>
        <view wx:if="{{wellnessView.summary}}" class="todo-reason">{{wellnessView.summary}}</view>
      </view>
      <view class="today-actions">
        <button class="today-entry" hover-class="access-active" bindtap="openTrainingEntry">{{todayView.submitted ? '补记训练' : '去记录训练'}} ›</button>
        <button class="today-entry" hover-class="access-active" bindtap="openWellnessEntry">{{wellnessView && wellnessView.filled ? '修改恢复日报' : '填写恢复日报'}} ›</button>
      </view>
    </block>
  </view>

  <view wx:if="{{canSelfReport && (todaySessions.length || sessionsLoading || sessionsError)}}" class="card today-sessions" aria-label="今日训练">
    <view class="card-head">
      <view><view class="card-head-title">今日训练</view><view class="todo-note">按课次展示当天训练记录</view></view>
      <button class="todo-refresh" bindtap="retrySessions" disabled="{{sessionsLoading}}" aria-label="刷新今日训练">刷新</button>
    </view>
    <view wx:if="{{sessionsLoading && !todaySessions.length}}" class="todo-note" aria-role="status" aria-live="polite" aria-atomic="true">正在读取今日训练…</view>
    <view wx:if="{{sessionsError}}" class="error-box">{{sessionsError}}</view>
    <view wx:if="{{!sessionsLoading && !sessionsError && !todaySessions.length}}" class="todo-note">今日暂无训练记录</view>
    <block wx:if="{{todaySessions.length}}">
      <view wx:for="{{todaySessions}}" wx:key="id" class="session-row">
        <view class="session-order">{{item.sessionOrder === 1 ? '上午' : item.sessionOrder === 2 ? '下午' : '第' + item.sessionOrder + '次'}}</view>
        <view class="session-info">
          <view class="session-type">{{item.trainingType}} · {{item.content}}</view>
          <view class="todo-note">{{item.startTime || '未填时间'}} · {{item.durationMin}} min{{item.distanceKm ? ' · ' + item.distanceKm + ' km' : ''}} · RPE {{item.rpe || '—'}} · 负荷 {{item.srpe || 0}} AU</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{canViewTodos}}" class="card daily-todos" aria-label="教练每日训练待办">
    <view class="card-head">
      <view><view class="card-head-title">每日训练待办</view><view class="todo-note">当前项目 · 权限范围内全部运动员</view></view>
      <button class="todo-refresh" bindtap="retryTodos" disabled="{{todosLoading}}" aria-label="刷新每日训练待办">刷新</button>
    </view>
    <view class="{{todosError ? 'error-box' : 'todo-note'}}" aria-role="status" aria-live="polite" aria-atomic="true">{{todosStatus}}</view>
    <block wx:if="{{!todosLoading && !todosError && todos && todoView}}">
      <view class="todo-note">{{todos.date}} · 北京时间 · 返回首页自动更新</view>
      <view class="todo-summary">未填报 {{todos.counts.missing}} 人 · 需关注 {{todos.counts.attention}} 人</view>
      <view wx:if="{{!todos.counts.total}}" class="todo-note">当前项目暂无可访问的运动员。</view>
      <block wx:else>
        <scroll-view class="todo-chips" scroll-x enhanced show-scrollbar="false">
          <view wx:for="{{todoView.groups}}" wx:key="key" class="todo-chip {{item.active ? 'todo-chip-active' : ''}}" data-filter="{{item.key}}" bindtap="onTodoFilter" aria-label="{{item.label}} {{item.count}}人{{item.active ? '，当前已选中' : '，点击筛选'}}">
            <text>{{item.label}}</text><text class="todo-chip-count">{{item.count}}</text>
          </view>
        </scroll-view>
        <view class="todo-search-row">
          <input class="todo-search" type="text" value="{{todoKeyword}}" placeholder="搜索运动员姓名或队伍" bindinput="onTodoKeyword" confirm-type="search" aria-label="搜索待办运动员" />
        </view>

        <block wx:if="{{todoView.show.missing}}">
          <view class="todo-heading">当天未填报 · {{todoView.counts.missing}} 人</view>
          <view wx:if="{{!todoView.missing.length}}" class="todo-note">{{todoView.keyword ? '没有匹配的运动员。' : '今日全部运动员已填报。'}}</view>
          <button wx:for="{{todoView.missing}}" wx:key="athleteId" class="todo-row" hover-class="access-active" data-athlete-id="{{item.athleteId}}" bindtap="goToAthlete" aria-label="{{item.athleteName}}，今日未填报，查看档案">
            <view class="todo-row-head"><text>{{item.athleteName}}</text><text class="todo-link">查看档案 ›</text></view>
            <view class="todo-note">{{item.team || '未分队'}} · 今日暂无有效训练记录</view>
          </button>
        </block>
        <block wx:if="{{todoView.show.attention}}">
          <view class="todo-heading">负荷与伤病关注 · {{todoView.counts.attention}} 人</view>
          <view class="todo-note">近24小时 SRPE ≥ {{todos.highLoadThreshold}} AU；伤病按最新状态持续关注。</view>
          <view wx:if="{{!todoView.attention.length}}" class="todo-note">{{todoView.keyword ? '没有匹配的运动员。' : '暂无高负荷或伤病关注运动员。'}}</view>
          <button wx:for="{{todoView.attention}}" wx:key="athleteId" class="todo-row" hover-class="access-active" data-athlete-id="{{item.athleteId}}" bindtap="goToAthlete" aria-label="{{item.athleteName}}，{{item.reason}}，查看档案">
            <view class="todo-row-head"><text>{{item.athleteName}}</text><text class="todo-link">查看档案 ›</text></view>
            <view class="todo-note">{{item.team || '未分队'}}</view>
            <view class="todo-reason">{{item.reason}}</view>
          </button>
        </block>
        <block wx:if="{{todoView.show.incompleteTime}}">
          <view class="todo-heading">开训时间待补充 · {{todoView.counts.incompleteTime}} 人</view>
          <view class="todo-note">今日或昨日存在缺少有效开训时间的记录，未计入24小时负荷；今日记录仍计为已填报。</view>
          <view wx:if="{{!todoView.incompleteTime.length}}" class="todo-note">{{todoView.keyword ? '没有匹配的运动员。' : '暂无时间待补充的记录。'}}</view>
          <button wx:for="{{todoView.incompleteTime}}" wx:key="athleteId" class="todo-row" hover-class="access-active" data-athlete-id="{{item.athleteId}}" bindtap="goToAthlete" aria-label="{{item.athleteName}}，开训时间待补充，查看档案">
            <view class="todo-row-head"><text>{{item.athleteName}}</text><text class="todo-link">查看档案 ›</text></view>
          </button>
        </block>
      </block>
    </block>
  </view>

  <view wx:if="{{canViewTodos && (teamOverview || teamLoading || teamError)}}" class="card team-overview" aria-label="队伍总览">
    <view class="card-head">
      <view><view class="card-head-title">队伍总览</view><view class="todo-note">{{teamOverview ? teamOverview.date + ' · 北京时间' : '当日全队训练与状态'}}</view></view>
      <button class="todo-refresh" bindtap="retryTeam" disabled="{{teamLoading}}" aria-label="刷新队伍总览">刷新</button>
    </view>
    <view wx:if="{{teamLoading && !teamOverview}}" class="todo-note" aria-role="status" aria-live="polite" aria-atomic="true">正在读取队伍总览…</view>
    <view wx:if="{{teamError}}" class="error-box">{{teamError}}</view>
    <block wx:if="{{teamOverview && teamView}}">
      <view class="team-summary">
        <view class="team-stat"><view class="team-stat-value">{{teamOverview.summary.total}}</view><text class="team-stat-label">训练人数</text></view>
        <view class="team-stat"><view class="team-stat-value team-stat-ok">{{teamOverview.summary.trained}}</view><text class="team-stat-label">已完成</text></view>
        <view class="team-stat"><view class="team-stat-value team-stat-teal">{{teamOverview.summary.wellnessReported}}</view><text class="team-stat-label">已填报</text></view>
        <view class="team-stat"><view class="team-stat-value team-stat-orange">{{teamOverview.summary.averageLoad}}</view><text class="team-stat-label">平均负荷 AU</text></view>
      </view>
      <view class="todo-search-row">
        <input class="todo-search" type="text" value="{{teamKeyword}}" placeholder="搜索运动员姓名或队伍" bindinput="onTeamKeyword" confirm-type="search" aria-label="搜索运动员" />
      </view>
      <view wx:if="{{!teamView.athletes.length}}" class="todo-note">{{teamKeyword ? '没有匹配的运动员。' : '当前项目暂无可访问的运动员。'}}</view>
      <block wx:else>
        <view wx:for="{{teamView.athletes}}" wx:key="athleteId" class="team-athlete-row" data-athlete-id="{{item.athleteId}}" bindtap="goToAthlete" aria-label="{{item.athleteName}}，查看档案">
          <view class="team-athlete-head">
            <text class="team-athlete-name">{{item.athleteName}}</text>
            <text class="team-athlete-team">{{item.team || '未分队'}}</text>
            <text class="team-athlete-link">查看档案 ›</text>
          </view>
          <view class="team-athlete-tags">
            <text class="tag {{item.hasTraining ? 'ok' : 'warn'}}">{{item.hasTraining ? '已训练' : '未训练'}}</text>
            <text class="tag {{item.wellnessReported ? 'ok' : 'warn'}}">{{item.wellnessReported ? '已填报' : '未填报'}}</text>
            <text wx:if="{{item.highLoad}}" class="tag warn">高负荷</text>
          </view>
          <view class="todo-note">负荷 {{item.load24h}} AU{{item.sleepHours != null ? ' · 睡眠 ' + item.sleepHours + 'h' : ''}}{{item.morningPulse != null ? ' · 晨脉 ' + item.morningPulse : ''}}{{item.weightKg != null ? ' · 体重 ' + item.weightKg + 'kg' : ''}}</view>
        </view>
      </block>
    </block>
  </view>

  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view wx:if="{{loading}}" class="card state"><view class="state-icon">↻</view><view class="state-title">正在加载训练数据</view></view>

  <block wx:if="{{!loading}}">
    <view wx:if="{{attention.show}}" class="attention-card">
      <view class="attention-mark">!</view>
      <view><view class="attention-title">{{attention.title}}</view><text>{{attention.summary}}</text></view>
    </view>

    <view class="metric-grid">
      <view wx:for="{{metrics}}" wx:key="label" class="metric-card {{item.tone}}">
        <view class="metric-label">{{item.label}}</view>
        <view class="metric-value">{{item.value}}<text>{{item.unit}}</text></view>
        <text class="metric-note">{{item.note}}</text>
      </view>
    </view>

    <view wx:if="{{activeInjuries.length}}" class="section-head"><view class="section-head-title">伤病关注</view><view class="section-head-note">点击运动员查看档案</view></view>
    <view wx:if="{{activeInjuries.length}}" class="card">
      <view class="list">
        <view wx:for="{{activeInjuries}}" wx:key="athleteId" class="list-row access" hover-class="access-active" data-athlete-id="{{item.athleteId}}" bindtap="goToAthlete">
          <view class="list-row-main"><view><view class="list-row-title">{{item.athleteName}}</view><text class="list-row-meta">{{item.bodyPart}} · {{item.injuryName || '需关注状态'}}</text></view><view class="list-row-value">疼痛 {{item.painScore}}</view></view>
          <text class="tag {{item.status === 'observation' ? 'warn' : 'danger'}}">{{item.statusLabel}}</text>
        </view>
      </view>
    </view>

    <view class="section-head"><view class="section-head-title">训练量统计</view><view class="section-head-note">最近训练趋势</view></view>
    <view class="card">
      <view wx:if="{{trend.length}}" class="chart-meta">
        <view class="chart-legend"><view class="legend-item"><view class="legend-dot" />训练时长（分钟）</view><view class="legend-item"><view class="legend-dot accent" />SRPE负荷（AU）</view></view>
        <text class="chart-hint">点击柱形查看</text>
      </view>
      <scroll-view wx:if="{{trend.length}}" class="trend-scroll" scroll-x enhanced show-scrollbar="false">
        <view class="trend-chart">
          <view wx:for="{{trend}}" wx:key="date" class="trend-day" data-index="{{index}}" bindtap="showTrendDetail">
            <view class="trend-bars">
              <view class="trend-bar" style="height: {{item.durationHeight}}%;" />
              <view class="trend-bar accent" style="height: {{item.loadHeight}}%;" />
            </view>
            <text class="trend-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="state"><view class="state-icon">—</view><view class="state-title">暂无训练量数据</view></view>
    </view>

    <view class="section-head"><view class="section-head-title">训练强度占比</view><view class="section-head-note">按强度区间统计训练时长</view></view>
    <view class="card">
      <view wx:if="{{intensity.length}}" class="ratio-list">
        <view wx:for="{{intensity}}" wx:key="name">
          <view class="ratio-row-head"><text>{{item.name}} · {{item.value}}</text><text>{{item.percentage}}%</text></view>
          <view class="ratio-track"><view class="ratio-fill" style="width: {{item.width}}%;" /></view>
        </view>
      </view>
      <view wx:else class="state"><view class="state-icon">—</view><view class="state-title">暂无有效强度数据</view></view>
    </view>

    <view class="section-head"><view class="section-head-title">生理生化热力图</view><view class="section-head-note">团队指标风险状态</view></view>
    <view wx:if="{{physiologyHeatmap}}" class="card">
      <view class="heat-grid">
        <view class="heat-header"><view class="heat-cell heat-metric">指标</view><view wx:for="{{physiologyHeatmap.metrics[0].heatDates || []}}" wx:key="*this" class="heat-cell heat-date">{{item}}</view></view>
        <view wx:for="{{physiologyHeatmap.metrics}}" wx:key="code" class="heat-row">
          <view class="heat-cell heat-metric">{{item.label}}</view>
          <view wx:for="{{item.days}}" wx:key="date" class="heat-cell {{item.statusClass}} {{item.isEstimated ? 'estimated' : ''}}" data-median="{{item.median}}" data-sample="{{item.sampleCount}}" data-change="{{item.abnormalRateChange}}"></view>
        </view>
      </view>
      <view wx:if="{{heatHasEstimated}}" class="heat-legend">V1 模拟状态（等待实测导入）</view>
      <view wx:else class="heat-legend">颜色：绿=正常 黄=波动 橙=关注 红=异常 灰=未监测</view>
    </view>
    <view wx:else class="card state"><view class="state-icon">—</view><view class="state-title">暂无生理生化数据</view></view>

  </block>
</view>
