.trend-chart { min-width: 690rpx; }
.daily-todos .card-head { margin-bottom: 12rpx; }
.todo-note { color: #46616c; font-size: 24rpx; line-height: 1.65; overflow-wrap: break-word; }
.todo-summary { margin-top: 16rpx; color: #164751; font-size: 30rpx; font-weight: 700; }
.todo-heading { margin-top: 26rpx; margin-bottom: 10rpx; color: #164751; font-size: 26rpx; font-weight: 700; }
.todo-row { display: block; width: 100%; min-height: 88rpx; margin: 12rpx 0 0; padding: 20rpx; border: 1rpx solid #d8e3e6; border-radius: 16rpx; background: #edf3f4; text-align: left; line-height: 1.5; }
.todo-row-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; color: #12303b; font-size: 28rpx; font-weight: 700; }
.todo-link { flex: none; color: #176373; font-size: 24rpx; }
.todo-reason { margin-top: 10rpx; color: #7a4715; font-size: 24rpx; line-height: 1.65; }
.todo-row:focus { outline: 4rpx solid #176373; outline-offset: 4rpx; }
.todo-chips { width: 100%; margin-top: 18rpx; white-space: nowrap; }
.todo-chip { display: inline-flex; align-items: center; gap: 10rpx; margin-right: 12rpx; padding: 12rpx 20rpx; border: 1rpx solid #d8e3e6; border-radius: 999rpx; color: #176373; background: #edf3f4; font-size: 23rpx; line-height: 1.4; }
.todo-chip-active { color: #ffffff; border-color: #176f7f; background: #176f7f; }
.todo-chip-count { min-width: 32rpx; padding: 2rpx 10rpx; border-radius: 999rpx; color: #164751; background: rgba(255, 255, 255, .7); font-size: 21rpx; font-weight: 700; text-align: center; }
.todo-chip-active .todo-chip-count { color: #0f4c58; }
.todo-search-row { margin-top: 16rpx; }
.todo-search { width: 100%; height: 78rpx; padding: 0 22rpx; border: 1rpx solid #ccdadd; border-radius: 16rpx; background: #ffffff; font-size: 25rpx; }
.todo-chip:focus-within, .todo-search:focus { outline: 4rpx solid #176373; outline-offset: 2rpx; }
.attention-card { margin-bottom: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #efd2a6; border-radius: 18rpx; display: flex; align-items: center; gap: 16rpx; color: #80521e; background: #fff8ec; }
.attention-mark { width: 42rpx; height: 42rpx; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; background: #cf8428; font-size: 24rpx; font-weight: 800; }
.attention-title { color: #7a4715; font-size: 24rpx; font-weight: 800; }
.attention-card text { display: block; margin-top: 4rpx; font-size: 20rpx; }
.today-status .card-head { margin-bottom: 18rpx; }
.today-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.today-main { min-width: 0; flex: 1; }
.today-state { color: #164751; font-size: 32rpx; font-weight: 800; }
.today-state-ok { color: #176f7f; }
.today-state-warn { color: #974438; }
.today-load { flex: none; text-align: right; }
.today-load-value { color: #164751; font-size: 34rpx; font-weight: 800; }
.today-load-unit { margin-left: 6rpx; font-size: 20rpx; font-weight: 700; }
.today-load-label { display: block; margin-top: 4rpx; color: #71868d; font-size: 20rpx; }
.today-wellness { margin-top: 18rpx; padding: 18rpx 20rpx; border: 1rpx solid #d8e3e6; border-radius: 16rpx; background: #edf3f4; }
.today-actions { display: flex; gap: 14rpx; margin-top: 20rpx; }
.today-entry { flex: 1; min-height: 76rpx; margin: 0; padding: 14rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; color: #176373; background: #edf3f4; font-size: 25rpx; font-weight: 700; line-height: 1.5; }
.today-entry::after { border: 0; }
.today-entry:focus { outline: 4rpx solid #176373; outline-offset: 4rpx; }
/* 今日训练课次列表 */
.session-row { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 14rpx; padding: 16rpx 18rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #edf3f4; }
.session-order { flex: none; min-width: 72rpx; padding: 6rpx 12rpx; border-radius: 10rpx; color: #176373; background: rgba(23, 111, 127, .12); font-size: 22rpx; font-weight: 700; text-align: center; }
.session-info { min-width: 0; flex: 1; }
.session-type { color: #12303b; font-size: 27rpx; font-weight: 700; line-height: 1.5; }
/* 队伍总览 */
.team-overview .card-head { margin-bottom: 12rpx; }
.team-summary { display: flex; gap: 12rpx; margin-top: 16rpx; }
.team-stat { flex: 1; padding: 16rpx 10rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #edf3f4; text-align: center; }
.team-stat-value { color: #164751; font-size: 34rpx; font-weight: 800; }
.team-stat-ok { color: #176f7f; }
.team-stat-teal { color: #0d7a72; }
.team-stat-orange { color: #b06818; }
.team-stat-label { display: block; margin-top: 4rpx; color: #71868d; font-size: 20rpx; }
.team-athlete-row { display: block; margin-top: 12rpx; padding: 18rpx 20rpx; border: 1rpx solid #d8e3e6; border-radius: 16rpx; background: #edf3f4; }
.team-athlete-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.team-athlete-name { color: #12303b; font-size: 28rpx; font-weight: 700; }
.team-athlete-team { color: #71868d; font-size: 22rpx; }
.team-athlete-link { margin-left: auto; color: #176373; font-size: 24rpx; }
.team-athlete-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.team-athlete-row .todo-note { margin-top: 8rpx; }
.team-athlete-actions { display: flex; gap: 14rpx; margin-top: 12rpx; }
.team-athlete-actions .mini-button { flex: 1; margin: 0; height: 58rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #cbdadd; border-radius: 14rpx; color: #176f7f; background: #fff; font-size: 21rpx; line-height: 1; }
.team-athlete-actions .mini-button:focus { outline: 4rpx solid #176373; outline-offset: 2rpx; }
/* 训练负荷管理 ACWR */
.acwr-summary { display: flex; gap: 12rpx; margin-top: 16rpx; }
.acwr-stat { flex: 1; padding: 16rpx 10rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #edf3f4; text-align: center; }
.acwr-stat-value { color: #164751; font-size: 34rpx; font-weight: 800; }
.acwr-under { color: #71868d; }
.acwr-optimal { color: #176f7f; }
.acwr-danger { color: #b04030; }
.acwr-stat-label { display: block; margin-top: 4rpx; color: #71868d; font-size: 20rpx; }
.acwr-row { margin-top: 14rpx; padding: 16rpx 18rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #edf3f4; }
.acwr-row-head { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.acwr-name { color: #12303b; font-size: 27rpx; font-weight: 700; }
.acwr-zone { flex: none; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; }
.acwr-zone-under { color: #5a6d75; background: rgba(113, 134, 141, .15); }
.acwr-zone-optimal { color: #0f5c68; background: rgba(23, 111, 127, .15); }
.acwr-zone-danger { color: #974438; background: rgba(176, 64, 48, .15); }
.acwr-bar-track { height: 12rpx; margin-top: 10rpx; border-radius: 999rpx; background: #d8e3e6; overflow: hidden; }
.acwr-bar-fill { height: 100%; border-radius: 999rpx; transition: width .3s; }
.acwr-bar-under { background: #71868d; }
.acwr-bar-optimal { background: #176f7f; }
.acwr-bar-danger { background: #b04030; }
/* 恢复状态基线偏离预警 */
.baseline-row { margin-top: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #edf3f4; }
.baseline-row-head { display: flex; align-items: center; gap: 10rpx; }
.baseline-name { color: #12303b; font-size: 27rpx; font-weight: 700; }
.baseline-severity { flex: none; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; }
.baseline-sev-warn { color: #7a4715; background: rgba(207, 132, 40, .15); }
.baseline-sev-alert { color: #974438; background: rgba(176, 64, 48, .15); }
/* 训练计划执行率 */
.exec-summary { display: flex; gap: 12rpx; margin-top: 16rpx; }
.exec-stat { flex: 1; padding: 16rpx 10rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #edf3f4; text-align: center; }
.exec-stat-value { color: #164751; font-size: 34rpx; font-weight: 800; }
.exec-complete { color: #176f7f; }
.exec-partial { color: #b06818; }
.exec-missed { color: #b04030; }
.exec-stat-label { display: block; margin-top: 4rpx; color: #71868d; font-size: 20rpx; }
.exec-row { margin-top: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #edf3f4; }
.exec-row-head { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.exec-name { color: #12303b; font-size: 27rpx; font-weight: 700; }
.exec-status { flex: none; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; }
.exec-status-complete { color: #0f5c68; background: rgba(23, 111, 127, .15); }
.exec-status-partial { color: #7a4715; background: rgba(207, 132, 40, .15); }
.exec-status-missed { color: #974438; background: rgba(176, 64, 48, .15); }
.exec-status-no-plan { color: #5a6d75; background: rgba(113, 134, 141, .15); }
.exec-bar-track { height: 10rpx; margin-top: 10rpx; border-radius: 999rpx; background: #d8e3e6; overflow: hidden; }
.exec-bar-fill { height: 100%; border-radius: 999rpx; }
.exec-bar-complete { background: #176f7f; }
.exec-bar-partial { background: #cf8428; }
.exec-bar-missed { background: #b04030; }
/* 生理生化指标卡片 */
.physio-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-bottom: 18rpx; }
.physio-card { padding: 20rpx; border: 1rpx solid #d8e3e6; border-radius: 18rpx; background: #ffffff; }
.physio-card-head { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.physio-card-label { color: #536c75; font-size: 21rpx; font-weight: 700; line-height: 1.3; }
.physio-card-status { flex: none; padding: 3rpx 12rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 700; }
.physio-card-status.normal { color: #0f5c68; background: rgba(23, 111, 127, .12); }
.physio-card-status.fluctuation { color: #7a4715; background: rgba(207, 132, 40, .15); }
.physio-card-status.attention { color: #974438; background: rgba(176, 64, 48, .12); }
.physio-card-status.abnormal { color: #974438; background: rgba(176, 64, 48, .18); }
.physio-card-status.missing { color: #5a6d75; background: rgba(113, 134, 141, .12); }
.physio-card-value { display: flex; align-items: baseline; gap: 6rpx; margin-top: 12rpx; }
.physio-value-num { color: #092b39; font-size: 38rpx; font-weight: 800; }
.physio-value-unit { color: #71868d; font-size: 20rpx; }
.physio-trend-arrow { margin-left: auto; font-size: 28rpx; font-weight: 800; }
.physio-trend-arrow.up { color: #b04030; }
.physio-trend-arrow.down { color: #176f7f; }
.physio-trend-arrow.stable { color: #71868d; }
.physio-spark { margin-top: 10rpx; height: 60rpx; }
.physio-spark-svg { width: 100%; height: 100%; }
.physio-spark-empty { margin-top: 10rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; color: #a8b5b9; font-size: 18rpx; }
.physio-card-meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 8rpx; color: #8b9a9f; font-size: 18rpx; }
/* 生理生化热力图 */
.physio-heat-card { margin-top: 0; }
.heat-grid { overflow-x: auto; }
.heat-header { display: flex; gap: 4rpx; margin-bottom: 6rpx; }
.heat-row { display: flex; gap: 4rpx; margin-bottom: 4rpx; }
.heat-cell { flex: none; }
.heat-metric { width: 160rpx; min-width: 160rpx; display: flex; align-items: center; color: #536c75; font-size: 20rpx; font-weight: 700; line-height: 1.3; }
.heat-date { width: 52rpx; min-width: 52rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; color: #7b8e95; font-size: 16rpx; }
.heat-row .heat-cell:not(.heat-metric) { width: 52rpx; min-width: 52rpx; height: 52rpx; border-radius: 6rpx; }
.heat-row button.heat-cell { margin: 0; padding: 0; border: 0; line-height: 1; }
.heat-row button.heat-cell::after { border: 0; }
.heat-row button.heat-cell:focus { box-shadow: inset 0 0 0 4rpx #0b706b; }
.heat-cell.normal { background: #5db89a; }
.heat-cell.fluctuation { background: #e8c44a; }
.heat-cell.attention { background: #e8944a; }
.heat-cell.abnormal { background: #d4544a; }
.heat-cell.missing { background: #d8e3e6; }
.heat-cell.estimated { opacity: .55; border: 2rpx dashed rgba(255,255,255,.6); }
.heat-cell.sample-0 { background: #bedad7; }
.heat-cell.sample-1 { background: #9fc9c3; }
.heat-cell.sample-2 { background: #d5e7e4; }
.heat-legend { margin-top: 14rpx; color: #8b9a9f; font-size: 19rpx; line-height: 1.5; }
