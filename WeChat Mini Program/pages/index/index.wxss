.trend-chart { min-width: 690rpx; }
.attention-card { margin-bottom: 18rpx; padding: 20rpx 22rpx; border: 1rpx solid #efd2a6; border-radius: 18rpx; display: flex; align-items: center; gap: 16rpx; color: #80521e; background: #fff8ec; }
.attention-mark { width: 42rpx; height: 42rpx; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; background: #cf8428; font-size: 24rpx; font-weight: 800; }
.attention-title { color: #7a4715; font-size: 24rpx; font-weight: 800; }
.attention-card text { display: block; margin-top: 4rpx; font-size: 20rpx; }
.page-head-action { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.page-head-copy { min-width: 0; flex: 1; }
.quick-entry {
  width: 174rpx;
  height: 66rpx;
  margin: 0;
  padding: 0 17rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(110deg, #0b5363, #16827d);
  box-shadow: 0 10rpx 22rpx rgba(8, 83, 97, .2);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
}
.quick-entry::after { border: 0; }
.quick-entry-icon {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, .4);
  border-radius: 9rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, .13);
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1;
}
.quick-entry-active { opacity: .82; transform: scale(.98); }
