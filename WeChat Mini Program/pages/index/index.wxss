@import "../../templates/training-state.wxss";
/* 总览按手机纵向阅读组织，图表内容始终受卡片宽度约束。 */
.overview-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.overview-metrics .metric-card { min-width: 0; box-sizing: border-box; padding: 20rpx 18rpx; }
.overview-metrics .metric-value { font-size: 36rpx; line-height: 1.2; overflow-wrap: anywhere; }
.overview-metrics .metric-value text { margin-left: 6rpx; font-size: 19rpx; }
.overview-metrics .metric-note { display: block; margin-top: 8rpx; font-size: 20rpx; line-height: 1.4; }
.chart-card, .structure-card, .focus-card, .team-overview { box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden; }
/* 今日队伍晨检：人数卡片与紧凑人员状态列表优先于训练图表，适配手机纵向阅读。 */
.morning-card { box-sizing: border-box; width: 100%; max-width: 100%; padding: 20rpx; overflow: hidden; }
.morning-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.morning-stats-pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.morning-stat { min-width: 0; padding: 18rpx 14rpx; border: 1rpx solid #d8e3e6; border-radius: 16rpx; background: #f6f9f9; text-align: center; }
.morning-stat.tone-ok { border-color: #cfe0d8; background: #eef6f1; }
.morning-stat.tone-warn { border-color: #f0d9b0; background: #fff1d8; }
.morning-stat-value { color: #164751; font-size: 40rpx; line-height: 1.2; font-weight: 800; overflow-wrap: anywhere; }
.morning-stat.tone-warn .morning-stat-value { color: #7a4715; }
.morning-stat-unit { margin-left: 6rpx; color: #536c75; font-size: 19rpx; font-weight: 400; }
.morning-stat-label { margin-top: 8rpx; color: #536c75; font-size: 20rpx; line-height: 1.4; }
.morning-filters { display: flex; flex-wrap: nowrap; gap: 12rpx; margin-bottom: 14rpx; }
.morning-filter { flex: none; margin: 0; padding: 8rpx 22rpx; border: 1rpx solid #d8e3e6; border-radius: 999rpx; color: #536c75; background: #ffffff; font-size: 21rpx; line-height: 1.5; }
.morning-filters .morning-filter { flex: 1; min-width: 0; padding-right: 12rpx; padding-left: 12rpx; white-space: nowrap; }
.morning-filter::after { border: 0; }
.morning-filter.is-active { color: #ffffff; border-color: #176f7f; background: #176f7f; }
.morning-filter:focus { outline: 3rpx solid #176373; outline-offset: 1rpx; }
.morning-table-head, .morning-row.overview-person-button { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: 12rpx; align-items: center; }
.morning-table-head { padding: 10rpx 4rpx; color: #536c75; font-size: 20rpx; }
.morning-row.overview-person-button { box-sizing: border-box; width: 100%; max-width: 100%; margin: 0; padding: 22rpx 4rpx; border: 0; border-bottom: 1rpx solid #d8e3e6; border-radius: 0; background: transparent; text-align: left; line-height: 1.5; }
.morning-row::after { border: 0; }
.morning-name { min-width: 0; color: #12303b; font-size: 25rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.morning-measures { min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; text-align: right; }
.morning-measure-value { min-width: 0; color: #12303b; font-size: 28rpx; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
.morning-measure-value.is-empty { color: #536c75; font-weight: 400; }
.morning-missing-note { margin-top: 12rpx; color: #536c75; font-size: 21rpx; }

/* 今日训练计划：重点/内容行 + 计划量 + 安排详情；教练与运动员卡片共用。 */
.plan-focus-row { display: flex; align-items: baseline; gap: 14rpx; padding: 10rpx 4rpx; border-bottom: 1rpx solid #edf2f3; }
.plan-focus-row:last-of-type { border-bottom: 0; }
.plan-label { flex: none; color: #71868d; font-size: 20rpx; }
.plan-value { min-width: 0; flex: 1; color: #12303b; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.plan-volume-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 12rpx; }
.plan-volume { min-width: 0; padding: 14rpx 16rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #f6f9f9; }
.plan-volume-value { display: block; margin-top: 6rpx; color: #164751; font-size: 28rpx; font-weight: 800; overflow-wrap: anywhere; }
.plan-detail { margin-top: 16rpx; }
.plan-detail-title { margin: 16rpx 0 8rpx; color: #536c75; font-size: 21rpx; font-weight: 700; }
.plan-detail-row { display: flex; align-items: baseline; gap: 12rpx; padding: 8rpx 4rpx; }
.plan-detail-name { flex: none; max-width: 40%; color: #12303b; font-size: 22rpx; font-weight: 600; overflow-wrap: anywhere; }
.plan-detail-note { min-width: 0; flex: 1; color: #536c75; font-size: 20rpx; line-height: 1.5; overflow-wrap: anywhere; }
/* 今日执行情况：紧凑数字块 + 待确认人员列表。 */
.exec-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.exec-tile { min-width: 0; padding: 14rpx 16rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #f6f9f9; }
.exec-tile-value { color: #164751; font-size: 32rpx; line-height: 1.2; font-weight: 800; overflow-wrap: anywhere; }
.exec-tile-unit { margin-left: 6rpx; color: #536c75; font-size: 18rpx; font-weight: 400; }
.exec-tile-label { margin-top: 6rpx; color: #536c75; font-size: 20rpx; line-height: 1.4; }
.exec-tile-note { margin-top: 4rpx; color: #71868d; font-size: 17rpx; line-height: 1.4; }
.exec-row { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr) minmax(0, 1fr); gap: 8rpx; align-items: center; box-sizing: border-box; width: 100%; max-width: 100%; margin: 10rpx 0 0; padding: 16rpx 12rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #f6f9f9; }
.exec-row-team, .exec-row-focus { min-width: 0; color: #536c75; font-size: 20rpx; overflow-wrap: anywhere; }
.exec-row-focus { color: #12303b; }
.exec-session-row { margin-top: 10rpx; padding: 14rpx 16rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #f6f9f9; }
.exec-session-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.exec-session-rpe { flex: none; color: #164751; font-size: 21rpx; font-weight: 700; }
.chart-legend { display: flex; flex-wrap: wrap; gap: 18rpx; margin-bottom: 14rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; color: #536c75; font-size: 20rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #176f7f; }
.legend-dot.accent { background: #176f7f; }
.legend-dot.team-average { background: #cf8428; }
.chart-empty { padding: 32rpx 12rpx; color: #71868d; font-size: 23rpx; line-height: 1.5; text-align: center; }
.trend-chart { display: flex; align-items: stretch; justify-content: space-between; gap: 6rpx; width: 100%; max-width: 100%; height: 220rpx; padding: 0; box-sizing: border-box; }
.trend-day { flex: 1; min-width: 0; height: 220rpx; margin: 0; padding: 0 2rpx; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-end; border: 0; background: transparent; line-height: 1; }
.trend-day::after { border: 0; }
.trend-day:focus { outline: 3rpx solid #176373; outline-offset: 1rpx; }
.trend-bars { flex: none; height: 180rpx; width: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 4rpx; border-bottom: 1rpx solid #d8e3e6; background: repeating-linear-gradient(to top, transparent 0, transparent 43rpx, #edf2f3 44rpx); }
.trend-bar { width: 38%; max-width: 20rpx; min-height: 0; border-radius: 6rpx 6rpx 0 0; background: #176f7f; }
.trend-bar.team-average { background: #cf8428; opacity: .72; }
.trend-label { flex: none; height: 28rpx; margin-top: 8rpx; color: #71868d; font-size: 17rpx; line-height: 28rpx; text-align: center; white-space: nowrap; }
.structure-track { height: 22rpx; display: flex; overflow: hidden; border-radius: 999rpx; background: #edf2f3; }
.structure-segment { height: 100%; min-width: 0; }
.structure-segment.special, .structure-dot.special { background: #176f7f; }
.structure-segment.physical, .structure-dot.physical { background: #cf8428; }
.structure-segment.recovery, .structure-dot.recovery { background: #74a58f; }
.structure-list { margin-top: 18rpx; }
.structure-row { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 0; border-bottom: 1rpx solid #edf2f3; color: #536c75; font-size: 22rpx; }
.structure-row:last-child { border-bottom: 0; }
.structure-label { min-width: 90rpx; flex: 1; display: flex; align-items: center; gap: 10rpx; }
.structure-dot { width: 14rpx; height: 14rpx; flex: none; border-radius: 50%; }
.structure-value { min-width: 130rpx; color: #12303b; text-align: right; }
.structure-percent { min-width: 70rpx; color: #71868d; text-align: right; }
.rpe-chart { height: 240rpx; display: flex; align-items: stretch; gap: 8rpx; position: relative; padding-left: 36rpx; box-sizing: border-box; }
.rpe-axis { position: absolute; top: 0; bottom: 36rpx; left: 0; display: flex; flex-direction: column; justify-content: space-between; color: #71868d; font-size: 17rpx; }
.rpe-day { flex: 1; min-width: 0; margin: 0; padding: 0; display: flex; flex-direction: column; justify-content: flex-end; border: 0; background: transparent; line-height: 1; }
.rpe-day::after { border: 0; }
.rpe-day:focus { outline: 3rpx solid #176373; outline-offset: 1rpx; }
.rpe-plot { flex: none; height: 204rpx; position: relative; border-bottom: 1rpx solid #d8e3e6; background: repeating-linear-gradient(to top, transparent 0, transparent 48rpx, #edf2f3 49rpx); }
.rpe-range { position: absolute; left: 25%; width: 50%; border-radius: 5rpx; background: rgba(23, 111, 127, .18); }
.rpe-mark, .rpe-team-mark { position: absolute; left: 10%; width: 80%; height: 6rpx; border-radius: 999rpx; background: #176f7f; transform: translateY(50%); }
.rpe-team-mark { left: 22%; width: 56%; height: 4rpx; background: #cf8428; }
.chart-footnote { margin-top: 12rpx; color: #71868d; font-size: 19rpx; line-height: 1.45; }
.focus-card .focus-row { display: block; box-sizing: border-box; width: 100%; max-width: 100%; margin: 12rpx 0 0; padding: 20rpx; border: 1rpx solid #d8e3e6; border-radius: 14rpx; background: #f6f9f9; }
.focus-row-head { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.focus-name { min-width: 0; color: #12303b; font-size: 25rpx; font-weight: 700; overflow-wrap: break-word; }
.focus-tags { min-width: 0; max-width: 100%; margin-left: auto; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6rpx; }
.focus-tag { flex: none; padding: 4rpx 12rpx; border-radius: 999rpx; color: #7a4715; background: #fff1d8; font-size: 19rpx; }
.focus-row .todo-note { margin-top: 7rpx; }
.focus-card .todo-note { color: #536c75; font-size: 22rpx; line-height: 1.5; overflow-wrap: break-word; }
/* 运动员今日状态：负荷摘要优先，训练与恢复分别呈现状态和操作。 */
.today-status { margin-top: 20rpx; padding: 24rpx; }
.today-head { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.today-title { color: #164751; font-size: 30rpx; font-weight: 800; }
.today-subtitle, .today-date { display: block; color: #536c75; font-size: 20rpx; line-height: 1.5; }
.today-subtitle { margin-top: 6rpx; }
.today-date { padding-top: 6rpx; }
.today-feedback { padding: 18rpx 0; color: #536c75; font-size: 23rpx; line-height: 1.5; }
.today-announcement { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.today-load-panel { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding: 22rpx 24rpx; border: 1rpx solid #d8e3e6; border-radius: 20rpx; background: #edf3f4; }
.today-load-label { color: #536c75; font-size: 22rpx; }
.today-load-value { margin-top: 8rpx; color: #164751; font-size: 52rpx; line-height: 1.2; font-weight: 800; overflow-wrap: anywhere; }
.today-load-unit { margin-left: 10rpx; color: #536c75; font-size: 22rpx; font-weight: 400; }
.today-load-note { color: #536c75; font-size: 20rpx; line-height: 1.6; white-space: pre-line; }
.today-time-note { margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 14rpx; color: #7a4715; background: #fff1d8; font-size: 21rpx; line-height: 1.6; }
.today-task-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 18rpx; }
.today-task { display: flex; flex-direction: column; min-width: 0; padding: 20rpx 16rpx; border: 1rpx solid #d8e3e6; border-radius: 18rpx; }
.today-task-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.today-task-title { color: #12303b; font-size: 25rpx; font-weight: 700; }
.today-badge { padding: 4rpx 10rpx; border-radius: 999rpx; font-size: 19rpx; line-height: 1.5; }
.today-badge.is-complete { color: #0f5961; background: #edf3f4; }
.today-badge.is-pending { color: #7a4715; background: #fff1d8; }
.today-task-note { display: block; flex: 1; margin: 12rpx 0 20rpx; color: #536c75; font-size: 21rpx; line-height: 1.6; overflow-wrap: anywhere; }
.today-entry { display: flex; align-items: center; justify-content: center; align-self: stretch; flex: none; box-sizing: border-box; width: auto; min-width: 0; max-width: 100%; min-height: 44px; margin: 0; padding: 16rpx 10rpx; border: 1rpx solid #176f7f; border-radius: 14rpx; font-size: 23rpx; font-weight: 700; line-height: 1.5; white-space: normal; overflow-wrap: anywhere; }
.today-entry-primary { color: #ffffff; background: #176f7f; }
.today-entry-secondary { color: #176f7f; background: #ffffff; }
.today-entry:focus { outline: 3rpx solid #176373; outline-offset: 4rpx; }

@media (max-width: 360px) {
  .today-task-grid { grid-template-columns: minmax(0, 1fr); }
  .overview-metrics { gap: 10rpx; }
  .overview-metrics .metric-card { padding: 16rpx 14rpx; }
  .trend-chart { gap: 2rpx; }
  .trend-label { font-size: 15rpx; }
  .rpe-chart { gap: 4rpx; padding-left: 30rpx; }
}

/* 网格和基线由内部绘图区提供，外层仅为真实图表与空状态保留同等空间。 */
.overview-chart-stage { position: relative; min-height: 220rpx; }
.overview-rpe-stage { min-height: 240rpx; }
.overview-chart-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 1; pointer-events: none; }
.overview-chart-overlay .state { min-height: 0; padding: 20rpx; background: rgba(255, 255, 255, .9); border-radius: 12rpx; }
.overview-chart-overlay button { pointer-events: auto; }
.structure-status { min-height: 64rpx; padding: 12rpx 0; color: #536c75; font-size: 23rpx; line-height: 1.5; }
/* 通用按钮仅负责交互布局，保留人员行各自的背景、圆角和上下间距。 */
.overview-person-button { display: block; box-sizing: border-box; width: 100%; min-width: 0; margin-right: 0; margin-left: 0; text-align: left; line-height: 1.5; }
.overview-person-button:focus { outline: 3rpx solid #176373; outline-offset: 1rpx; }

.focus-actions, .focus-filters { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.focus-actions button { margin: 0; padding: 8rpx 16rpx; min-height: 80rpx; font-size: 22rpx; line-height: 2.6; color: #176373; background: #fff; }
.focus-actions button:focus { outline: 3rpx solid #176373; outline-offset: 2rpx; }
.focus-filters button[aria-pressed="true"] { color: #fff; background: #176373; }
