<view class="page training-form-page">
  <view class="page-head"><view class="page-title">{{editId ? '修改训练记录' : '填写训练记录'}}</view><view class="page-description">本人填写的数据直接进入网页版训练统计</view></view>
  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view class="card form-card">
    <view class="form-grid"><view class="field"><text class="field-label">训练日期 *</text><picker mode="date" value="{{form.date}}" bindchange="onDateChange"><view class="picker-input">{{form.date}}</view></picker></view><view class="field"><text class="field-label">开始时间</text><picker mode="time" value="{{form.startTime}}" bindchange="onTimeChange"><view class="picker-input">{{form.startTime || '可不填'}}</view></picker></view></view>
    <view class="form-grid"><view class="field"><text class="field-label">训练类型 *</text><picker range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange"><view class="picker-input">{{form.trainingType}}</view></picker></view><view class="field"><text class="field-label">强度区 *</text><picker range="{{intensityOptions}}" value="{{intensityIndex}}" bindchange="onIntensityChange"><view class="picker-input">{{form.intensityZone}}</view></picker></view></view>
    <view class="field"><text class="field-label">训练内容 *</text><textarea class="textarea" value="{{form.content}}" data-field="content" bindinput="onInput" maxlength="100" placeholder="如：水上技术划、下肢力量、拉伸恢复"/></view>
    <view class="form-grid"><view class="field"><text class="field-label">训练时长（分钟）*</text><input class="input" type="digit" value="{{form.duration}}" data-field="duration" bindinput="onInput"/></view><view class="field"><text class="field-label">RPE（1—10）*</text><input class="input" type="digit" value="{{form.rpe}}" data-field="rpe" bindinput="onInput"/></view></view>
    <view class="field"><text class="field-label">距离（公里）</text><input class="input" type="digit" value="{{form.distance}}" data-field="distance" bindinput="onInput" placeholder="无距离可不填"/></view>
    <button class="text-button advanced-toggle" bindtap="toggleAdvanced">{{showAdvanced ? '收起训练指标' : '填写心率、功率等指标'}}</button>
    <view wx:if="{{showAdvanced}}" class="form-grid advanced-fields"><view class="field"><text class="field-label">平均心率 bpm</text><input class="input" type="digit" value="{{form.averageHeartRate}}" data-field="averageHeartRate" bindinput="onInput"/></view><view class="field"><text class="field-label">最大心率 bpm</text><input class="input" type="digit" value="{{form.maxHeartRate}}" data-field="maxHeartRate" bindinput="onInput"/></view><view class="field"><text class="field-label">平均功率 W</text><input class="input" type="digit" value="{{form.averagePowerW}}" data-field="averagePowerW" bindinput="onInput"/></view><view class="field"><text class="field-label">桨频/划频 次/分</text><input class="input" type="digit" value="{{form.strokeRateSpm}}" data-field="strokeRateSpm" bindinput="onInput"/></view></view>
    <view class="button-row {{editId ? 'editing' : ''}}"><button wx:if="{{editId}}" class="secondary-button" bindtap="cancelEdit">取消修改</button><button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? '正在保存' : (editId ? '保存修改' : '保存训练')}}</button></view>
  </view>

  <view class="section-head"><view class="section-head-title">最近本人填写</view><view class="section-head-note">只显示可由本人修改或删除的记录</view></view>
  <view wx:if="{{loading}}" class="card state"><view class="state-icon">↻</view><view class="state-title">正在加载训练记录</view></view>
  <view wx:elif="{{sessions.length}}" class="card session-card"><view class="list"><view wx:for="{{sessions}}" wx:key="id" class="list-row"><view class="list-row-main"><view><view class="list-row-title">{{item.content}}</view><text class="list-row-meta">{{item.date}} {{item.startTime}} · {{item.trainingType}} · {{item.intensityZone}}</text></view><view class="list-row-value">{{item.duration}} 分钟</view></view><text class="session-metrics">RPE {{item.rpe}}<text wx:if="{{item.distance !== null}}"> · {{item.distance}} km</text></text><view class="session-actions"><button class="mini-button" data-id="{{item.id}}" bindtap="editSession">修改</button><button class="mini-button danger" data-id="{{item.id}}" bindtap="deleteSession">删除</button></view></view></view></view>
  <view wx:else class="card state"><view class="state-icon">＋</view><view class="state-title">还没有本人填写的训练记录</view><text class="state-note">上方保存后，网页版训练总览会读取同一条数据</text></view>
</view>
