.training-form-page { padding-bottom: 80rpx; }
.form-card { width: 100%; padding-bottom: 24rpx; }
.form-grid { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16rpx; }
.form-grid > .field { min-width: 0; }
.field picker { width: 100%; display: block; }
.picker-input { width: 100%; max-width: 100%; height: 86rpx; padding: 0 22rpx; display: flex; align-items: center; overflow: hidden; border: 1rpx solid #ccdadd; border-radius: 16rpx; background: #fff; font-size: 25rpx; white-space: nowrap; text-overflow: ellipsis; }
.form-card .input { width: 100%; max-width: 100%; }
.textarea { width: 100%; max-width: 100%; min-height: 150rpx; padding: 20rpx 22rpx; border: 1rpx solid #ccdadd; border-radius: 16rpx; background: #fff; font-size: 25rpx; line-height: 1.55; }
.advanced-toggle { width: 100%; margin: -2rpx 0 16rpx; }
.advanced-fields { padding-top: 18rpx; border-top: 1rpx solid #e3ebed; }
.button-row { display: grid; grid-template-columns: 1fr; gap: 14rpx; margin-top: 4rpx; }
.button-row.editing { grid-template-columns: 1fr 1.5fr; }
.session-card { padding: 18rpx; }
.session-card .list-row { min-width: 0; }
.session-card .list-row-main > view:first-child { min-width: 0; flex: 1; }
.session-card .list-row-title, .session-card .list-row-meta { overflow-wrap: anywhere; }
.session-metrics { display: block; margin-top: 12rpx; color: #526c75; font-size: 21rpx; }
.session-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 14rpx; }
.mini-button { min-width: 108rpx; height: 58rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #cbdadd; border-radius: 14rpx; color: #176f7f; background: #fff; font-size: 21rpx; line-height: 1; }
.mini-button.danger { color: #a64234; border-color: #e4b8af; background: #fff8f6; }
