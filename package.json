{
  "name": "training-monitor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "check": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "plan-check": "node scripts/training-plan-check.mjs",
    "plan-visual-check": "node scripts/training-plan-visual-check.mjs",
    "strength-training-check": "node scripts/strength-training-check.mjs",
    "special-training-check": "node scripts/special-training-check.mjs",
    "special-test-check": "node scripts/special-test-check.mjs",
    "database-lock-check": "node scripts/database-lock-check.mjs",
    "data-import-check": "tsx scripts/data-import-check.ts",
    "training-content-ratio-check": "tsx scripts/training-content-ratio-check.ts",
    "api-check": "node scripts/api-check.mjs",
    "visual-check": "node scripts/visual-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "china-map-geojson": "^1.0.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "latest",
    "html2canvas": "latest",
    "jsonwebtoken": "latest",
    "jspdf": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "province-city-china": "^8.5.8",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "^26.6.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.36.0",
    "playwright-core": "latest",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "latest",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "11.1.1",
    "brace-expansion": "5.0.9"
  }
}
