{
  "name": "training-monitor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "check": "tsc -b --pretty false",
    "plan-check": "node scripts/training-plan-check.mjs",
    "plan-visual-check": "node scripts/training-plan-visual-check.mjs",
    "strength-training-check": "node scripts/strength-training-check.mjs",
    "special-training-check": "node scripts/special-training-check.mjs",
    "database-lock-check": "node scripts/database-lock-check.mjs",
    "api-check": "node scripts/api-check.mjs",
    "visual-check": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "china-map-geojson": "^1.0.4",
    "d3-geo": "^3.1.1",
    "exceljs": "^4.4.0",
    "express": "latest",
    "html2canvas": "latest",
    "jsonwebtoken": "latest",
    "jspdf": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "province-city-china": "^8.5.8",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright-core": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vite": "latest"
  },
  "overrides": {
    "uuid": "11.1.1",
    "brace-expansion": "5.0.9"
  }
}
